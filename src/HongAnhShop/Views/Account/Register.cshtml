 <button type="submit" class="au-submit" id="aureliaRegisterSubmit">ĐĂNG KÝ <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
 <p id="aureliaNotice" class="au-notice" role="status" aria-live="polite" hidden></p>

<script>
(function() {
 'use strict';
 const form = document.getElementById('aureliaRegisterForm');
 const notice = document.getElementById('aureliaNotice');
 const fieldIds = ['FullName','EmailOrPhone','Password','ConfirmPassword','AgreeTerms'];
 let attempted=false;
 const emailRE=/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
 const vnPhoneRE=/^(?:\+84|84|0)(?:3|5|7|8|9)\d{8}$/;
 function val(id) { const e=document.getElementById(id);return e.type==='checkbox'?e.checked:e.value; }
 function validate() {
   const e={};
   const name=val('FullName').trim().replace(/\s+/g,' ');
   if(!name)e.FullName='Vui lòng nhập họ và tên.';
   else if(name.length<2 || name.length>100)e.FullName='Họ và tên phải từ 2 đến 100 ký tự.';
   const ident=val('EmailOrPhone').trim();
   if(!ident)e.EmailOrPhone='Vui lòng nhập email hoặc số điện thoại.';
   else if(/^[+\d\s.\-]+$/.test(ident)){if(!vnPhoneRE.test(ident.replace(/[\s.\-]/g,'')))e.EmailOrPhone='Số điện thoại Việt Nam không hợp lệ.';}
   else if(!emailRE.test(ident))e.EmailOrPhone='Email không đúng định dạng.';
   if(!val('Password'))e.Password='Vui lòng nhập mật khẩu.';
   else if(val('Password').length<8)e.Password='Mật khẩu phải có ít nhất 8 ký tự.';
   if(!val('ConfirmPassword'))e.ConfirmPassword='Vui lòng xác nhận mật khẩu.';
   else if(val('ConfirmPassword')!==val('Password'))e.ConfirmPassword='Mật khẩu xác nhận không khớp.';
   if(!val('AgreeTerms'))e.AgreeTerms='Bạn cần đồng ý với điều khoản để tiếp tục.';
   return e;
 }
 function displayErrors(e) {fieldIds.forEach(id=>{const el=document.getElementById(id),msg=document.getElementById('error-'+id);msg.textContent=e[id]||'';msg.hidden=!e[id];el.setAttribute('aria-invalid',e[id]?'true':'false');});}
 form.addEventListener('submit',function(ev){
   attempted=true;const errors=validate();displayErrors(errors);
   const first=fieldIds.find(id=>errors[id]);
   if(first){ev.preventDefault();document.getElementById(first).focus();return;}
   const button=document.getElementById('aureliaRegisterSubmit');button.disabled=true;button.textContent='ĐANG XỬ LÝ…';
   // Allow normal POST to MVC controller; no fabricated success message.
 });
 fieldIds.forEach(id=>{document.getElementById(id).addEventListener('input',()=>{if(attempted)displayErrors(validate());});document.getElementById(id).addEventListener('change',()=>{if(attempted)displayErrors(validate());});});
 document.querySelectorAll('[data-toggle]').forEach(button=>button.addEventListener('click',()=>{
  const input=document.getElementById(button.dataset.toggle),shown=input.type==='text';input.type=shown?'password':'text';button.setAttribute('aria-label',shown?'Hiện mật khẩu':'Ẩn mật khẩu');button.innerHTML=shown?'<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.1A11.5 11.5 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-3.1 3.6M6.1 6.1C3.5 8 2 12 2 12s3.5 6 10 6c1.3 0 2.5-.2 3.6-.7"/><path d="M10 10a3 3 0 0 0 4 4"/></svg>':'<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12"/><circle cx="12" cy="12" r="3"/></svg>';
 }));
 function tell(message) {notice.hidden=false;notice.textContent=message;}
 document.querySelectorAll('[data-social]').forEach(btn=>btn.addEventListener('click',()=>tell('Đăng ký bằng '+btn.dataset.social+' đang được tích hợp.')));
 document.querySelectorAll('[data-info]').forEach(btn=>btn.addEventListener('click',()=>tell(btn.dataset.info+' đang được hoàn thiện.')));
})();
</script>

<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>


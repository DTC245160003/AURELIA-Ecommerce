@{ Layout = null; ViewData["Title"] = "Đăng ký tài khoản — AURELIA"; }
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng ký tài khoản — AURELIA</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700;800&family=Cormorant+Garamond:wght@@400;500;600&family=Noto+Serif:wght@@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--au-black:#080b0d;--au-ivory:#f4f0e8;--au-gold:#d2b27c;--au-gold-light:#f5d692;--au-silver:#b1b4ba;--au-err:#ffaaa2;}
*{box-sizing:border-box}html,body{margin:0;min-width:320px;min-height:100%;}body{background:var(--au-black);color:var(--au-ivory);font-family:'Be Vietnam Pro',system-ui,Arial,sans-serif;font-size:14px;-webkit-font-smoothing:antialiased;}
button,input{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--au-gold-light);outline-offset:3px}
.au-screen{position:relative;isolation:isolate;min-height:100vh;min-height:100dvh;overflow-x:hidden;background:#090c0d;}
.au-scene{position:absolute;z-index:-2;inset:0;background-image:url('data:image/jpeg;base64,');background-repeat:no-repeat;background-size:cover;background-position:43% 57%;}
.au-screen:before{position:absolute;inset:0;z-index:-1;content:'';background:linear-gradient(90deg,rgba(7,8,9,.44) 0%,rgba(8,9,10,.36) 44%,rgba(7,9,10,.65) 76%,rgba(7,9,10,.83) 100%);pointer-events:none}
.au-layout{position:relative;display:grid;grid-template-columns:minmax(0,60%) minmax(0,40%);min-height:100vh;min-height:100dvh;width:100%;}
.au-left{padding:clamp(22px,3.2vh,40px) 10px 28px clamp(44px,7.5vw,148px);min-width:0}
.au-brand{display:inline-flex;flex-direction:column;align-items:flex-start;max-width:100%;}
.au-logo{font-family:'Cormorant Garamond','Noto Serif',"Times New Roman",serif;font-size:clamp(42px,4.6vw,80px);font-weight:400;line-height:1.06;letter-spacing:.23em;padding-left:.03em;color:var(--au-gold-light);text-shadow:0 2px 12px #0008;white-space:nowrap}
.au-tagline{font-size:clamp(8px,.8vw,11px);font-weight:500;letter-spacing:.07em;margin-top:3px;color:#fff;line-height:1.5;white-space:normal}
.au-copy{margin-top:clamp(34px,8vh,88px);max-width:650px;text-shadow:0 3px 12px #0009}
.au-eyebrow{margin:0 0 8px;font-size:clamp(16px,1.5vw,24px);font-weight:400;letter-spacing:.1em}
.au-headline{margin:0;font-family:'Noto Serif',Georgia,'Times New Roman',serif;font-size:clamp(38px,4.2vw,75px);font-weight:650;letter-spacing:-.025em;line-height:1.23;color:var(--au-gold-light);text-wrap:balance;}
.au-headline span{display:block;padding-top:.04em;white-space:nowrap}
.au-desc{max-width:550px;margin:clamp(8px,1.5vh,19px) 0 0;font-size:clamp(12px,1vw,16px);line-height:1.68;font-weight:450}
.au-right{display:flex;justify-content:center;align-items:center;min-width:0;padding:clamp(12px,2.3vh,26px) clamp(22px,3.5vw,60px) clamp(12px,2.3vh,26px) 0}
.au-card{width:100%;max-width:594px;padding:clamp(15px,2.2vh,26px) clamp(22px,2.8vw,47px) clamp(15px,2.2vh,26px);border:1.5px solid var(--au-gold);border-radius:22px;background:linear-gradient(125deg,rgba(29,32,31,.93),rgba(12,17,18,.95));box-shadow:0 0 32px rgba(195,152,74,.22),0 26px 60px rgba(0,0,0,.55),inset 0 0 25px rgba(227,196,121,.045);backdrop-filter:blur(15px);}
.au-card-header{text-align:center}
.au-card-logo{display:inline-block;font-family:'Cormorant Garamond','Noto Serif',"Times New Roman",serif;font-size:clamp(38px,5.5vh,62px);letter-spacing:.19em;line-height:1.04;color:var(--au-gold-light);font-weight:400;}
.au-card-title{font-size:clamp(14px,2.1vh,21px);margin:4px 0 0;letter-spacing:.23em;font-weight:600}
.au-divider-gold{width:62px;height:1.5px;background:var(--au-gold);margin:clamp(7px,1.45vh,15px) auto 0}
.au-fields{display:grid;gap:clamp(8px,1.12vh,13px);margin-top:clamp(12px,1.8vh,20px)}
.au-field{min-width:0}
.au-field-label{display:block;font-size:clamp(12px,.95vw,14px);font-weight:600;margin-bottom:5px;line-height:1.3;color:#fff}
.au-input-wrap{position:relative;display:block}
.au-input{display:block;width:100%;height:clamp(39px,5.5vh,51px);border-radius:6px;border:1px solid #636767;background:rgba(12,17,19,.8);outline:none;color:#f4f0e8;font-size:clamp(12px,.85vw,14px);padding:0 42px 0 48px;transition:border-color .15s,box-shadow .15s;}
.au-input::placeholder{color:#9da1a6;opacity:1}
.au-input:hover{border-color:#9c8a6e}.au-input:focus{border-color:var(--au-gold);box-shadow:0 0 0 2px rgba(210,178,124,.2)}.au-input[aria-invalid=true]{border-color:#ed9d96}
.au-input-icon{position:absolute;left:15px;top:50%;transform:translateY(-50%);pointer-events:none;display:flex;color:#e0e3e6}
.au-input-icon svg,.au-eye svg{width:20px;height:20px;stroke-width:1.8}
.au-eye{position:absolute;right:11px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:0;color:#e5e5e5;background:transparent;border-radius:6px}
.au-eye:hover{color:var(--au-gold-light)}
.au-error{color:var(--au-err);font-size:11px;line-height:1.3;margin:4px 0 0}
.au-terms{display:flex;align-items:flex-start;gap:10px;margin-top:clamp(9px,1.35vh,14px);font-size:clamp(11px,.9vw,13px);line-height:1.45}
.au-terms input{appearance:none;flex:0 0 19px;width:19px;height:19px;margin:0;border:1px solid var(--au-gold);border-radius:3px;cursor:pointer;background:#101617;position:relative}
.au-terms input:checked::after{content:'✓';position:absolute;inset:-1px 0 0;text-align:center;color:var(--au-gold-light);font-weight:bold;font-size:17px;line-height:17px}
.au-inline{background:none;border:0;padding:0;color:var(--au-gold-light);text-decoration:underline;text-underline-offset:3px;font-weight:550}
.au-submit{border:0;width:100%;height:clamp(40px,5.6vh,53px);display:flex;align-items:center;justify-content:center;gap:20px;margin-top:clamp(9px,1.4vh,15px);border-radius:6px;color:#090b0c;background:linear-gradient(110deg,#f9e5a8,#d1ab69);font-size:clamp(15px,1.12vw,19px);font-weight:800;letter-spacing:.04em;box-shadow:0 6px 20px rgba(197,148,69,.17);transition:filter .2s, transform .2s}
.au-submit:hover:not(:disabled){filter:brightness(1.1);transform:translateY(-1px)}.au-submit:disabled{opacity:.65;cursor:not-allowed}
.au-submit svg{width:20px;height:20px}
.au-social-label{display:flex;align-items:center;gap:12px;margin-top:clamp(10px,1.55vh,18px);font-size:clamp(10px,.77vw,12px);letter-spacing:.11em;color:#bec0c1;white-space:nowrap}
.au-social-label:before,.au-social-label:after{content:'';flex:1;height:1px;background:#676c6e}
.au-social{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin-top:clamp(8px,1.2vh,13px)}
.au-social button{border:1px solid #5c6668;background:rgba(13,20,22,.73);height:clamp(36px,5.0vh,48px);border-radius:6px;color:#fff;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:550;transition:border-color .15s}
.au-social button:hover{border-color:var(--au-gold)}.au-social svg{width:20px;height:20px}
.au-foot{text-align:center;font-size:clamp(11px,.89vw,13px);margin:clamp(9px,1.45vh,18px) 0 0}
.au-foot a{color:var(--au-gold-light);font-weight:650;margin-left:5px}.au-foot a:hover{text-decoration:underline;text-underline-offset:3px}
.au-notice{font-size:11px;color:var(--au-gold-light);text-align:center;margin:7px 0 0;min-height:0}
.au-server-error{color:#ffc2bb;text-align:center;margin:9px 0 0;font-size:12px}
/* Compact layout for laptop viewport heights, including Windows browser chrome */
@@media(min-width:1024px) and (max-height:760px){
  .au-left{padding-top:22px}
  .au-logo{font-size:clamp(38px,4vw,58px)}
  .au-copy{margin-top:clamp(23px,6vh,44px)}
  .au-headline{font-size:clamp(35px,3.8vw,57px);line-height:1.18}
  .au-eyebrow{font-size:clamp(13px,1.25vw,20px);margin-bottom:4px}
  .au-desc{font-size:clamp(11px,.94vw,14px);max-width:470px}
  .au-right{padding-top:9px;padding-bottom:9px}
  .au-card{padding-top:12px;padding-bottom:12px}
  .au-card-logo{font-size:clamp(34px,5vh,45px)}
  .au-card-title{font-size:clamp(12px,1.95vh,16px);margin-top:1px}
  .au-divider-gold{margin-top:6px}
  .au-fields{gap:7px;margin-top:10px}
  .au-field-label{font-size:12px;margin-bottom:3px}
  .au-input{height:39px;font-size:12px}
  .au-terms{margin-top:7px;font-size:11px;line-height:1.34}
  .au-submit{height:42px;margin-top:8px;font-size:15px}
  .au-social-label{margin-top:8px;font-size:10px}
  .au-social{margin-top:7px}.au-social button{height:35px;font-size:12px}
  .au-foot{margin-top:8px;font-size:11px}
}
@@media(min-width:1024px) and (max-height:620px){
  .au-left{padding-top:12px}
  .au-copy{margin-top:12px}
  .au-headline{font-size:clamp(30px,3.25vw,50px)}
  .au-card{padding-top:8px;padding-bottom:8px}
  .au-card-logo{font-size:32px}
  .au-card-title{font-size:12px}
  .au-fields{gap:5px;margin-top:7px}
  .au-input{height:34px}
  .au-terms{margin-top:5px}
  .au-submit{height:36px;margin-top:6px}
  .au-social-label{margin-top:5px}
  .au-social{margin-top:5px}.au-social button{height:32px}
  .au-foot{margin-top:5px}
}
@@media(max-width:1120px) and (min-width:1024px){
 .au-layout{grid-template-columns:minmax(0,56%) minmax(0,44%)}
 .au-left{padding-left:4vw}
 .au-right{padding-right:2.4vw}
 .au-card{padding-left:20px;padding-right:20px}
 .au-headline{font-size:clamp(32px,3.5vw,53px)}
 .au-logo{font-size:clamp(38px,4vw,58px)}
}
@@media(max-width:1023px){
 .au-screen{overflow-y:auto}
 .au-scene{height:360px;bottom:auto;background-position:36% 62%}
 .au-screen:before{background:linear-gradient(180deg,rgba(8,10,11,.43) 0%,rgba(8,10,11,.45) 215px,#080b0d 470px,#080b0d 100%)}
 .au-layout{display:flex;flex-direction:column;min-height:100dvh}
 .au-left{padding:22px 20px 0;text-align:center}
 .au-brand{align-items:center;width:100%}
 .au-logo{font-size:clamp(38px,7vw,60px)}
 .au-tagline{font-size:9px}
 .au-copy{display:none}
 .au-right{padding:clamp(110px,20vh,160px) 18px 25px}
 .au-card{max-width:555px;padding:20px clamp(18px,4vw,32px) 24px}
 .au-card-logo{font-size:46px}
 .au-card-title{font-size:16px}
 .au-fields{gap:12px;margin-top:17px}
 .au-input{height:46px;font-size:13px}
 .au-social button{height:44px}
 .au-terms{font-size:12px}
}
@@media(max-width:450px){
 .au-right{padding:108px 12px 20px}
 .au-card{padding:17px 17px 20px;border-radius:16px}
 .au-card-logo{font-size:38px}
 .au-card-title{font-size:13px;letter-spacing:.17em}
 .au-tagline{font-size:7.6px}
 .au-terms{font-size:11px}
 .au-social{gap:9px}
 .au-social-label{gap:7px;font-size:9px}
 .au-foot{font-size:11px}
}
@@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>

<style id="aurelia-light-style" media="not all">
/* AURELIA light registration: keep the image, make the form a clear white card */
:root{--au-black:#f8f7f3;--au-ivory:#282520;--au-gold:#876537;
 --au-gold-light:#876537;--au-silver:#736d64;--au-err:#ae4444}
html{color-scheme:light}body{background:#f8f7f3;color:#282520}
.au-screen{background:#f8f7f3}
.au-left{color:#fff}
.au-logo,.au-headline{color:#f1d49b}
.au-left .au-tagline,.au-left .au-eyebrow,.au-left .au-desc{color:#fff}
.au-right{background:rgba(249,247,243,.58)}
.au-card{background:rgba(255,255,255,.97);border-color:#d0b17e;color:#292520;
 box-shadow:0 22px 62px rgba(46,34,16,.19);backdrop-filter:blur(12px)}
.au-card-logo,.au-card-title{color:#886638}
.au-field-label{color:#332e28}
.au-input{background:#fff;color:#282520;border-color:#d4c9b8}
.au-input::placeholder{color:#817970}
.au-input-icon,.au-eye{color:#806a51}
.au-terms input{background:#fff}
.au-terms input:checked::after{color:#83602d}
.au-inline,.au-foot a{color:#80602f}
.au-social-label{color:#7d756b}
.au-social-label:before,.au-social-label:after{background:#d9cfc0}
.au-social button{background:#fff;color:#36302a;border-color:#d8cabb}
.au-social button:hover{background:#f5ead9}
.au-error{color:#a43838}
.au-submit{color:#20180e}


</style>
<style id="aurelia-theme-toggle-style">

/* AURELIA THEME SWITCH CONTROL - fixed, does not affect car/banners photos */
#aurelia-theme-toggle {
  all: unset !important;
  position: fixed !important;
  z-index: 2147483000 !important;
  left: 20px !important;
  bottom: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  box-sizing: border-box !important;
  min-height: 44px !important;
  padding: 11px 17px !important;
  border: 1px solid #bda06e !important;
  border-radius: 999px !important;
  background: #18191b !important;
  color: #f3e1c1 !important;
  font: 600 12px/1.2 'Segoe UI', Arial, sans-serif !important;
  letter-spacing: 0 !important;
  white-space: nowrap !important;
  text-decoration: none !important;
  -webkit-text-fill-color: currentColor !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
  transition: background-color .2s,color .2s,transform .15s !important;
}
#aurelia-theme-toggle:hover { transform: translateY(-2px) !important; }
#aurelia-theme-toggle:focus-visible { outline: 3px solid #c8a56a !important; outline-offset: 3px !important; }
#aurelia-theme-toggle .aurelia-theme-icon { font-size: 20px !important; line-height: 1 !important; color: inherit !important; }
#aurelia-theme-toggle .aurelia-theme-label { color: inherit !important; font: inherit !important; }
html[data-aurelia-theme="light"] #aurelia-theme-toggle {
  background: #ffffff !important;
  color: #72552c !important;
  border-color: #cbb17f !important;
  box-shadow: 0 8px 22px rgba(72,51,18,.12) !important;
}
@@media(max-width: 520px) {
  #aurelia-theme-toggle { left: 12px !important; bottom: 12px !important; padding: 9px 13px !important; min-height: 42px !important; }
}

</style>

<script id="aurelia-theme-boot">
// Apply the saved choice before the page is painted (default: original dark theme).
(function () {
  var mode = 'dark';
  try {
    if (window.localStorage.getItem('aurelia.theme') === 'light') mode = 'light';
  } catch (_) { /* Browsers blocking storage still support temporary switching. */ }
  document.documentElement.setAttribute('data-aurelia-theme', mode);
  var lightStyle = document.getElementById('aurelia-light-style');
  if (lightStyle) lightStyle.media = mode === 'light' ? 'all' : 'not all';
})();
</script>

</head>
<body>
<main class="au-screen"><div class="au-scene" role="img" aria-label="Siêu xe màu đen ánh vàng trước biệt thự ven biển lúc hoàng hôn"></div>
<div class="au-layout">
 <section class="au-left">
  <a class="au-brand" href="@Url.Action("Index", "Home")" aria-label="AURELIA — Về trang chủ"><span class="au-logo">AURELIA</span><span class="au-tagline">SIÊU XE ĐẲNG CẤP DÀNH CHO NHỮNG CHỦ NHÂN XỨNG TẦM</span></a>
  <div class="au-copy"><p class="au-eyebrow">KHỞI ĐẦU HÀNH TRÌNH</p><h1 class="au-headline"><span>TRỞ THÀNH</span><span>CHỦ NHÂN</span><span>ĐẲNG CẤP</span></h1><p class="au-desc">Tạo tài khoản AURELIA để khám phá thế giới siêu xe độc quyền, ưu đãi dành riêng cho thành viên và trải nghiệm dịch vụ đẳng cấp khác biệt.</p></div>
 </section>
 <section class="au-right">
 <form id="aureliaRegisterForm" class="au-card" method="post" action="@Url.Action("Register", "Account")" novalidate>
 @Html.AntiForgeryToken()
 <header class="au-card-header"><a href="@Url.Action("Index", "Home")" class="au-card-logo">AURELIA</a><h2 class="au-card-title">ĐĂNG KÝ TÀI KHOẢN</h2><div class="au-divider-gold"></div></header>
 <div class="au-fields">
 <div class="au-field">
 <label class="au-field-label" for="FullName">Họ và tên</label>
 <span class="au-input-wrap"><span class="au-input-icon"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span><input class="au-input" id="FullName" name="FullName" type="text" autocomplete="name" maxlength="100" placeholder="Nhập họ và tên của bạn" aria-describedby="error-FullName"/></span>
 <p class="au-error" id="error-FullName" aria-live="polite" hidden></p></div>
 <div class="au-field">
 <label class="au-field-label" for="EmailOrPhone">Email hoặc số điện thoại</label>
 <span class="au-input-wrap"><span class="au-input-icon"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg></span><input class="au-input" id="EmailOrPhone" name="EmailOrPhone" type="text" autocomplete="username" maxlength="255" placeholder="Nhập email hoặc số điện thoại của bạn" aria-describedby="error-EmailOrPhone"/></span>
 <p class="au-error" id="error-EmailOrPhone" aria-live="polite" hidden></p></div>
 <div class="au-field">
 <label class="au-field-label" for="Password">Mật khẩu</label>
 <span class="au-input-wrap"><span class="au-input-icon"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><input class="au-input" id="Password" name="Password" type="password" autocomplete="new-password" maxlength="128" placeholder="Tạo mật khẩu (ít nhất 8 ký tự)" aria-describedby="error-Password"/><button class="au-eye" type="button" data-toggle="Password" aria-label="Hiện mật khẩu"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.1A11.5 11.5 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-3.1 3.6M6.1 6.1C3.5 8 2 12 2 12s3.5 6 10 6c1.3 0 2.5-.2 3.6-.7"/><path d="M10 10a3 3 0 0 0 4 4"/></svg></button></span>
 <p class="au-error" id="error-Password" aria-live="polite" hidden></p></div>
 <div class="au-field">
 <label class="au-field-label" for="ConfirmPassword">Xác nhận mật khẩu</label>
 <span class="au-input-wrap"><span class="au-input-icon"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><input class="au-input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" placeholder="Nhập lại mật khẩu của bạn" aria-describedby="error-ConfirmPassword"/><button class="au-eye" type="button" data-toggle="ConfirmPassword" aria-label="Hiện mật khẩu"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.1A11.5 11.5 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-3.1 3.6M6.1 6.1C3.5 8 2 12 2 12s3.5 6 10 6c1.3 0 2.5-.2 3.6-.7"/><path d="M10 10a3 3 0 0 0 4 4"/></svg></button></span>
 <p class="au-error" id="error-ConfirmPassword" aria-live="polite" hidden></p></div>

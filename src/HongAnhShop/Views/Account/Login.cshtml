@{
    // Trang Login AURELIA độc lập, không can thiệp _Layout/Home.
    Layout = null;
    ViewData["Title"] = "Đăng nhập — AURELIA";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Đăng nhập AURELIA để khám phá thế giới siêu xe đẳng cấp." />
    <title>Đăng nhập — AURELIA Siêu xe đẳng cấp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Cinzel:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --black: #10171a;
            --charcoal: #171d1f;
            --gold: #c7ab72;
            --gold-metal: #d0b36f;
            --gold-light: #f1dc9a;
            --ivory: #f5f0e7;
            --silver: #acb0b2;
            --gold-gradient:linear-gradient(135deg,#f3db9c 0%,#d5b573 48%,#c2a46c 100%);
            --gold-shadow:0 0 40px -6px rgba(209,174,99,.55),inset 0 0 30px -12px rgba(209,174,99,.38);
        }
        *,*::before,*::after {box-sizing:border-box}
        [hidden] {display:none!important}
        html {min-height:100%;scroll-behavior:smooth}
        body {margin:0;min-height:100vh;min-height:100dvh;background:var(--black);color:var(--ivory);font-family:'Be Vietnam Pro',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5}
        button,input,a {font:inherit}
        button {cursor:pointer}
        button:disabled {cursor:wait}
        a {color:inherit;text-decoration:none}
        :focus-visible {outline:2px solid var(--gold-light);outline-offset:3px}
        .page {min-height:100vh;min-height:100dvh;position:relative;isolation:isolate;overflow-x:hidden;display:flex}
        .scenery {position:absolute;inset:0;z-index:-3;background-image:url('data:image/jpeg;base64,');background-size:cover;background-repeat:no-repeat;background-position:30% center}
        .shade {position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(12,18,20,.80),rgba(12,18,20,.20) 51%,rgba(12,18,20,.63))}
        .shade-top {position:absolute;inset:0 0 50%;z-index:-1;background:linear-gradient(180deg,rgba(12,18,20,.66),transparent)}
        .layout {display:flex;min-height:100vh;min-height:100dvh;width:100%;align-items:stretch}
        .showcase {width:60%;flex:0 0 60%;padding:4.5vh 22px 30px max(34px,6vw)}
        .branding {width:max-content;max-width:100%;text-align:center}
        .brand {font-family:'Cinzel','Times New Roman',serif;font-size:clamp(38px,3.6vw,64px);line-height:1.13;letter-spacing:.24em;font-weight:400;padding-left:.24em;color:var(--gold-light);background:var(--gold-gradient);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .tagline {text-transform:uppercase;font-size:clamp(9px,.68vw,12px);letter-spacing:.035em;color:rgba(245,240,231,.88);margin:12px 0 0}
        .brand-divider,.form-divider {width:56px;height:1px;background:var(--gold-metal);margin:32px auto 0}
        .showcase-copy {padding-left:min(2.5vw,32px);max-width:660px;margin-top:31px}
        .eyebrow {font-size:clamp(15px,1.18vw,19px);font-weight:400;text-transform:uppercase;letter-spacing:.12em;color:rgba(245,240,231,.90);margin:0}
        .showcase h1 {font-family:'Playfair Display',Georgia,'Times New Roman',serif;font-weight:600;font-size:clamp(49px,4.3vw,78px);line-height:1.2;letter-spacing:-.035em;margin:11px 0 0;padding-top:.06em;color:var(--gold-light);background:var(--gold-gradient);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .showcase-description {font-size:clamp(13px,1vw,16px);line-height:1.78;color:rgba(245,240,231,.94);max-width:450px;margin:23px 0 0}
        .form-side {width:40%;flex:0 0 40%;display:flex;align-items:center;justify-content:flex-start;padding:5vh max(18px,2.5vw) 5vh 14px}
        .form-panel {width:100%;max-width:610px;padding:35px clamp(22px,3.5vw,58px) 36px;background:rgba(23,29,31,.81);border:2px solid rgba(208,179,111,.79);border-radius:18px;box-shadow:var(--gold-shadow);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
        .form-top {text-align:center}
        .form-brand {font-family:'Cinzel',"Times New Roman",serif;font-size:clamp(39px,3.6vw,59px);letter-spacing:.15em;padding-left:.15em;line-height:1.15;color:var(--gold-light);background:var(--gold-gradient);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .form-sub {text-transform:uppercase;font-size:clamp(16px,1.3vw,22px);letter-spacing:.14em;margin:11px 0 0;font-weight:400}
        .form-divider {margin-top:20px}
        .login-form {margin-top:28px}
        .field-group {margin:0 0 19px}
        .field-label {display:block;margin:0 0 8px;font-size:13px;font-weight:700;color:#fff}
        .field-wrap {min-height:56px;width:100%;display:flex;align-items:center;gap:12px;padding:0 16px;border-radius:6px;border:1px solid rgba(172,176,178,.41);background:rgba(16,23,26,.62);transition:border-color .2s,box-shadow .2s}
        .field-wrap:focus-within {border-color:var(--gold-metal);box-shadow:0 0 0 2px rgba(208,179,111,.16)}
        .field-wrap.invalid {border-color:#ff8787}
        .field-wrap svg {width:21px;height:21px;flex:0 0 21px;stroke:var(--ivory);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
        .field-wrap input {border:0;outline:0;box-shadow:none;color:var(--ivory);background:transparent;min-width:0;width:100%;height:54px;font-size:13px}
        .field-wrap input::placeholder {color:var(--silver);opacity:1}
        .eye-toggle {flex:0 0 28px;border:0;background:transparent;padding:4px;display:grid;place-items:center;color:var(--ivory);opacity:.85;transition:color .2s,opacity .2s}
        .eye-toggle:hover {color:var(--gold-light);opacity:1}
        .eye-toggle svg {width:21px;height:21px}
        .error-msg {font-size:12px;color:#ffaaaa;margin:6px 0 0;display:none}
        .error-msg.is-visible {display:block}
        .options {display:flex;align-items:center;justify-content:space-between;gap:10px;margin:5px 0 24px;font-size:13px}
        .remember {display:inline-flex;align-items:center;gap:10px;cursor:pointer;min-width:0}
        .remember input {appearance:none;-webkit-appearance:none;width:18px;height:18px;flex:0 0 18px;border:1px solid var(--gold-metal);border-radius:3px;background:transparent;cursor:pointer;margin:0;display:grid;place-items:center}
        .remember input:checked:after {content:'✓';font-size:12px;line-height:1;color:var(--gold-light)}
        .text-btn {color:var(--gold-metal);border:0;background:transparent;padding:0;font-weight:700;white-space:nowrap;font-size:13px}
        .text-btn:hover {color:var(--gold-light);text-decoration:underline}
        .primary-btn {display:flex;align-items:center;justify-content:center;gap:14px;width:100%;height:56px;border:0;border-radius:6px;background:var(--gold-gradient);color:#111;font-size:18px;text-transform:uppercase;font-weight:800;letter-spacing:.02em;box-shadow:var(--gold-shadow);transition:filter .2s,transform .2s}
        .primary-btn:hover {filter:brightness(1.1);transform:translateY(-1px)}
        .primary-btn:active {transform:translateY(0)}
        .primary-btn:disabled {opacity:.7;transform:none}
        .primary-btn svg,.signup svg {height:18px;width:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
        .notice {margin:13px 0 0;font-size:13px;color:var(--gold-light);text-align:center}
        .notice:empty {display:none}
        .server-validation {color:#ffb5b5;margin:12px 0 0;font-size:13px}
        .server-validation ul {padding-left:18px;margin:6px 0}
        .separator {display:flex;align-items:center;gap:16px;text-transform:uppercase;letter-spacing:.09em;font-size:11px;white-space:nowrap;color:rgba(245,240,231,.84);margin:27px 0 22px}
        .separator:before,.separator:after {content:'';height:1px;flex:1;min-width:12px;background:rgba(172,176,178,.43)}
        .socials {display:grid;grid-template-columns:1fr 1fr;gap:15px}
        .social-btn {height:54px;display:flex;align-items:center;justify-content:center;gap:12px;background:rgba(16,23,26,.52);color:var(--ivory);border:1px solid rgba(172,176,178,.43);border-radius:6px;transition:border-color .2s,background .2s}
        .social-btn:hover {border-color:var(--gold-metal);background:rgba(16,23,26,.75)}
        .social-btn svg {width:22px;height:22px;flex:0 0 22px}
        .signup {margin:26px 0 0;text-align:center;font-size:13px;color:var(--ivory)}
        .signup a {display:inline-flex;align-items:center;gap:7px;color:var(--gold-metal);font-weight:700;margin-left:3px}
        .signup a:hover {color:var(--gold-light);text-decoration:underline}
        @@media (min-width:1500px) { .form-panel {padding-top:40px;padding-bottom:38px} .field-group {margin-bottom:21px} }
        @@media (max-width:1200px) { .showcase {padding-left:4vw} .showcase h1 {font-size:clamp(42px,4.3vw,62px)} .form-side {padding-right:16px} .form-panel {padding:28px 26px} .form-brand {font-size:43px} .field-wrap {min-height:50px} .field-wrap input {height:49px} .primary-btn {height:52px} .social-btn {height:49px} .field-group {margin-bottom:15px} .separator {margin:19px 0 16px} .login-form {margin-top:23px} .signup {margin-top:20px} }
        @@media (max-width:900px) { .layout {flex-direction:column} .scenery {background-position:38% center} .shade {background:linear-gradient(180deg,rgba(12,18,20,.86),rgba(12,18,20,.4) 37%,rgba(12,18,20,.85) 86%)} .showcase {width:100%;flex:auto;padding:30px 6vw 20px;text-align:left} .branding {margin:auto} .brand-divider {margin-top:15px} .showcase-copy {padding-left:0;margin:28px auto 0;text-align:center} .showcase h1 {font-size:clamp(42px,7vw,65px)} .showcase-description {margin:14px auto 0} .form-side {width:100%;flex:auto;justify-content:center;padding:16px 5vw 40px} .form-panel {max-width:590px} }
        @@media (max-width:520px) { .showcase {padding:25px 18px 15px} .brand {font-size:39px} .tagline {font-size:9px;max-width:310px} .showcase-copy {margin-top:21px} .eyebrow {font-size:12px} .showcase h1 {font-size:42px;line-height:1.08} .showcase-description {font-size:12px} .form-side {padding:14px 12px 25px} .form-panel {border-radius:14px;padding:25px 20px} .form-brand {font-size:40px} .form-sub {font-size:16px} .form-divider {margin-top:12px} .login-form {margin-top:22px} .options {font-size:11px;gap:6px} .text-btn {font-size:11px} .separator {font-size:10px;gap:9px} .field-wrap {padding-left:12px;padding-right:12px} .field-wrap input {font-size:12px} }
        @@media (prefers-reduced-motion: reduce) {*,*::before,*::after {scroll-behavior:auto!important;transition:none!important;animation:none!important}}

        /* LAPTOP FIT FIX: chỉ thay đổi khoảng cách / kích thước trên màn hình thấp.
           Không sửa markup, ảnh, JavaScript, validation hay route ASP.NET. */
        @@media (min-width:901px) and (max-height:860px) {
            .layout {min-height:100dvh}
            .showcase {padding-top:18px;padding-bottom:14px}
            .brand {font-size:clamp(36px,3.4vw,58px)}
            .tagline {margin-top:6px}
            .brand-divider {margin-top:14px}
            .showcase-copy {margin-top:14px}
            .eyebrow {font-size:clamp(13px,1.1vw,17px)}
            .showcase h1 {font-size:clamp(41px,4vw,68px);line-height:1.2;margin-top:3px;padding-top:.06em}
            .showcase-description {margin-top:10px;line-height:1.55}
            .form-side {padding:12px max(16px,2.5vw) 12px 10px}
            .form-panel {padding:19px clamp(18px,2.4vw,36px) 17px}
            .form-brand {font-size:clamp(33px,3vw,48px);line-height:1.12}
            .form-sub {font-size:clamp(13px,1.1vw,17px);margin-top:5px}
            .form-divider {margin-top:11px}
            .login-form {margin-top:16px}
            .field-group {margin-bottom:11px}
            .field-label {margin-bottom:4px;font-size:12px}
            .field-wrap {min-height:44px;padding:0 12px}
            .field-wrap input {height:43px}
            .options {margin:5px 0 13px;font-size:12px}
            .primary-btn {height:47px;font-size:15px}
            .separator {margin:15px 0 13px;font-size:10px}
            .social-btn {height:43px}
            .socials {gap:12px}
            .signup {margin-top:13px;font-size:12px}
            .notice {margin-top:8px}
        }
        /* Màn laptop có vùng xem rất thấp: ưu tiên đủ form, vẫn giữ khả năng cuộn nếu có lỗi validation dài. */
        @@media (min-width:901px) and (max-height:620px) {
            .form-side {padding-top:8px;padding-bottom:8px}
            .form-panel {padding-top:12px;padding-bottom:12px}
            .form-brand {font-size:31px}
            .form-sub {margin-top:2px;font-size:12px}
            .form-divider {margin-top:7px}
            .login-form {margin-top:11px}
            .field-group {margin-bottom:7px}
            .field-wrap {min-height:40px}
            .field-wrap input {height:39px}
            .options {margin:3px 0 9px}
            .primary-btn {height:42px}
            .separator {margin:9px 0 8px}
            .social-btn {height:39px}
            .signup {margin-top:9px}
        }
    </style>

<style id="aurelia-light-style" media="not all">
/* AURELIA light login; photograph on the left is deliberately unchanged */
:root{--black:#f8f7f3;--charcoal:#fff;--ivory:#282520;--silver:#756e65;
 --gold:#886638;--gold-metal:#886638;--gold-light:#79582d}
html{color-scheme:light}
body{background:#f8f7f3;color:#282520}
.showcase{color:#fff}
.showcase .tagline,.showcase .eyebrow,.showcase .showcase-description{color:#f4eee3}
.showcase .brand,.showcase h1{color:#efd39a}
.form-side{background:rgba(249,247,243,.83)}
.form-panel{background:rgba(255,255,255,.97);border-color:#d5b67e;
 box-shadow:0 24px 65px rgba(43,34,21,.18)}
.form-brand{background:none;background-clip:initial;-webkit-background-clip:initial;
 -webkit-text-fill-color:#876236;color:#876236}
.field-label{color:#332e27}
.field-wrap{background:#fff;border-color:#d4cabc}
.field-wrap input{color:#29241f}
.field-wrap svg{stroke:#886f4a}
.field-wrap input::placeholder{color:#827a6e}
.eye-toggle{color:#5c5143}
.error-msg,.server-validation{color:#a33f3f}
.notice,.text-btn,.signup a{color:#79572d}
.separator{color:#71695f}
.separator:before,.separator:after{background:#d6cab8}
.social-btn{background:#fff;color:#332b22;border-color:#d6cbb7}
.social-btn:hover{background:#f5ede1;border-color:#be9d67}
.signup{color:#514b43}
.remember input{background:#fff}
.remember input:checked:after{color:#805d2e}
.primary-btn{color:#282018}


</style>
<style id="aurelia-theme-toggle-style">

/* AURELIA THEME SWITCH CONTROL - fixed, does not affect car/banners photos */
#aurelia-theme-toggle {
  all: unset !important;
  position: fixed !important;
  z-index: 2147483000 !important;
  left: 20px !important;
  bottom: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  box-sizing: border-box !important;
  min-height: 44px !important;
  padding: 11px 17px !important;
  border: 1px solid #bda06e !important;
  border-radius: 999px !important;
  background: #18191b !important;
  color: #f3e1c1 !important;
  font: 600 12px/1.2 'Segoe UI', Arial, sans-serif !important;
  letter-spacing: 0 !important;
  white-space: nowrap !important;
  text-decoration: none !important;
  -webkit-text-fill-color: currentColor !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
  transition: background-color .2s,color .2s,transform .15s !important;
}
#aurelia-theme-toggle:hover { transform: translateY(-2px) !important; }
#aurelia-theme-toggle:focus-visible { outline: 3px solid #c8a56a !important; outline-offset: 3px !important; }
#aurelia-theme-toggle .aurelia-theme-icon { font-size: 20px !important; line-height: 1 !important; color: inherit !important; }
#aurelia-theme-toggle .aurelia-theme-label { color: inherit !important; font: inherit !important; }
html[data-aurelia-theme="light"] #aurelia-theme-toggle {
  background: #ffffff !important;
  color: #72552c !important;
  border-color: #cbb17f !important;
  box-shadow: 0 8px 22px rgba(72,51,18,.12) !important;
}
@@media(max-width: 520px) {
  #aurelia-theme-toggle { left: 12px !important; bottom: 12px !important; padding: 9px 13px !important; min-height: 42px !important; }
}

</style>

<script id="aurelia-theme-boot">
// Apply the saved choice before the page is painted (default: original dark theme).
(function () {
  var mode = 'dark';
  try {
    if (window.localStorage.getItem('aurelia.theme') === 'light') mode = 'light';
  } catch (_) { /* Browsers blocking storage still support temporary switching. */ }
  document.documentElement.setAttribute('data-aurelia-theme', mode);
  var lightStyle = document.getElementById('aurelia-light-style');
  if (lightStyle) lightStyle.media = mode === 'light' ? 'all' : 'not all';
})();
</script>

</head>
<body>
    <main class="page">
      <div class="scenery" role="img" aria-label="Siêu xe màu đen trước biệt thự ven biển lúc hoàng hôn"></div>
      <div class="shade" aria-hidden="true"></div>
      <div class="shade-top" aria-hidden="true"></div>
      <div class="layout">
        <section class="showcase" aria-label="Giới thiệu AURELIA">
          <div class="branding">
            <a href="@Url.Action("Index", "Home")" aria-label="Về trang chủ AURELIA" class="brand">AURELIA</a>
            <p class="tagline">SIÊU XE ĐẲNG CẤP DÀNH CHO NHỮNG CHỦ NHÂN XỨNG TẦM</p>
            <div class="brand-divider"></div>
          </div>
          <div class="showcase-copy">
            <p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p>
            <h1>HÀNH TRÌNH<br/>ĐẲNG CẤP</h1>
            <p class="showcase-description">Đăng nhập để tiếp tục khám phá thế giới siêu xe dành riêng cho những chủ nhân xứng tầm.</p>
          </div>
        </section>
        <section class="form-side" aria-label="Biểu mẫu đăng nhập">
          <div class="form-panel">
            <div class="form-top">
              <div class="form-brand">AURELIA</div>
              <p class="form-sub">ĐĂNG NHẬP TÀI KHOẢN</p>
              <div class="form-divider"></div>
            </div>
            <form id="aurelia-login" class="login-form" method="post" action="@Url.Action("Login", "Account")" novalidate>
              @Html.AntiForgeryToken()
              <div class="field-group">
                <label class="field-label" for="EmailOrPhone">Email hoặc số điện thoại</label>
                <div class="field-wrap" id="id-wrap">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
                  <input id="EmailOrPhone" name="EmailOrPhone" type="text" placeholder="Nhập email hoặc số điện thoại của bạn" autocomplete="username" inputmode="email" spellcheck="false" required />
                </div>
                <p id="id-error" class="error-msg" role="alert"></p>
              </div>
              <div class="field-group">
                <label class="field-label" for="Password">Mật khẩu</label>
                <div class="field-wrap" id="pw-wrap">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="12" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  <input id="Password" name="Password" type="password" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" required />
                  <button type="button" id="toggle-password" class="eye-toggle" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <svg id="eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3 21 21"/><path d="M10.6 5.1a11 11 0 0 1 10 6.9 10 10 0 0 1-3.3 4.4M6.1 6.1A10.5 10.5 0 0 0 3 12c1.8 4.6 5.1 7 9 7 1.3 0 2.6-.3 3.8-.8"/><path d="M9.9 9.9A3 3 0 0 0 14.1 14.1"/></svg>
                    <svg id="eye-on" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </div>
                <p id="pw-error" class="error-msg" role="alert"></p>
              </div>
              <div class="options">
                <label class="remember"><input type="checkbox" name="RememberMe" value="true" checked /> Ghi nhớ đăng nhập</label>
                <button type="button" id="forgot-btn" class="text-btn">Quên mật khẩu?</button>
              </div>
              <button type="submit" id="submit-btn" class="primary-btn"><span id="submit-label">ĐĂNG NHẬP</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              </button>
              <p id="notice" class="notice" role="status" aria-live="polite"></p>
              <div class="server-validation" aria-live="polite">@Html.ValidationSummary(false, "", new { @class = "validation-summary" })</div>
              <div class="separator">HOẶC ĐĂNG NHẬP BẰNG</div>
              <div class="socials">

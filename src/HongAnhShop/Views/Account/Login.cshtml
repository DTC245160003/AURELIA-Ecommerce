    <script>
      (() => {
        'use strict';
        const form = document.getElementById('aurelia-login');
        const id = document.getElementById('EmailOrPhone');
        const pw = document.getElementById('Password');
        const msg = document.getElementById('notice');
        const eyeBtn = document.getElementById('toggle-password');
        const emailRE = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
        const phoneRE = /^(\+84|0)\d{9,10}$/;
        let submitted = false;
        const showError = (which, message) => {
          const target = document.getElementById(which + '-error');
          const border = document.getElementById(which + '-wrap');
          target.textContent = message || '';
          target.classList.toggle('is-visible', Boolean(message));
          border.classList.toggle('invalid', Boolean(message));
          document.getElementById(which === 'id' ? 'EmailOrPhone' : 'Password').setAttribute('aria-invalid', String(Boolean(message)));
        };
        function validate() {
          const identity = id.value.trim();
          const compact = identity.replace(/[\s.-]/g, '');
          let identityError = '', pwError = '';
          if (!identity) identityError = 'Vui lòng nhập email hoặc số điện thoại.';
          else if (!emailRE.test(identity) && !phoneRE.test(compact)) identityError = 'Email hoặc số điện thoại không hợp lệ.';
          if (!pw.value) pwError = 'Vui lòng nhập mật khẩu.';
          else if (pw.value.length < 6) pwError = 'Mật khẩu phải có ít nhất 6 ký tự.';
          showError('id',identityError);
          showError('pw',pwError);
          return !identityError && !pwError;
        }
        id.addEventListener('input', () => { msg.textContent = ''; if(submitted) validate(); });
        pw.addEventListener('input', () => { msg.textContent = ''; if(submitted) validate(); });
        eyeBtn.addEventListener('click', () => {
          const visible = pw.type === 'password';
          pw.type = visible ? 'text' : 'password';
          document.getElementById('eye-on').hidden = !visible;
          document.getElementById('eye-off').hidden = visible;
          eyeBtn.setAttribute('aria-label', visible ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
          eyeBtn.setAttribute('aria-pressed', String(visible));
        });
        form.addEventListener('submit', ev => {
          submitted = true;
          msg.textContent = '';
          if (!validate()) {
            ev.preventDefault();
            (document.querySelector('.field-wrap.invalid input') || id).focus();
            return;
          }
          // POST đến AccountController bằng cookie auth thực nếu đã triển khai.
          // Không giả lập trạng thái thành công, không lưu mật khẩu ở trình duyệt.
          document.getElementById('submit-btn').disabled = true;
          document.getElementById('submit-label').textContent = 'ĐANG XỬ LÝ...';
        });
        document.getElementById('forgot-btn').addEventListener('click', () => {msg.textContent = 'Tính năng khôi phục mật khẩu chưa được kết nối.';});
        document.querySelectorAll('[data-provider]').forEach(btn => btn.addEventListener('click', () => {msg.textContent = 'Đăng nhập bằng ' + btn.dataset.provider + ' chưa được kết nối.';}));
      })();
    </script>

<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>

</body>
</html>

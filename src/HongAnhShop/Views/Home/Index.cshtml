/* AURELIA inventory states: actual stock from MySQL */
.stock-label{font-size:11px;letter-spacing:.04em;margin:8px 0 0;font-weight:600}
.stock-label.available{color:#a4d1a9}
.stock-label.sold-out{color:#f0b7a9}
button:disabled{opacity:.46;cursor:not-allowed}
 .aurelia-cart-link{display:inline-flex;align-items:center;gap:6px;color:var(--champagne);font-size:11px;letter-spacing:.02em;text-decoration:none;white-space:nowrap;border:1px solid rgba(200,170,120,.4);border-radius:4px;padding:9px 12px} .aurelia-cart-link:hover{background:rgba(200,170,120,.10)}
</style>

<style id="aurelia-light-style" media="not all">
/* AURELIA LIGHT THEME • UI colors only; original imagery, JS and business flow unchanged */
:root{
  --obsidian:#f8f7f3;--charcoal:#ffffff;--graphite:#f1eee8;
  --ivory:#272522;--silver:#716c65;--champagne:#896538;--antique:#795a33;
  --border:rgba(126,105,77,.21);--input:rgba(126,105,77,.33)
}
html{color-scheme:light}
body{background:var(--obsidian);color:var(--ivory)}
.site-header{background:rgba(255,255,255,.96);box-shadow:0 3px 16px rgba(54,42,23,.06)}
.logo-name{color:#896538}.nav-link,.icon-btn{color:#282520}
.nav-link:hover,.icon-btn:hover,.logo-name:hover{color:var(--champagne)}
.account-popover{background:#fff;box-shadow:0 18px 40px rgba(66,48,25,.15)}
.account-popover a:hover{background:#f5eddf;color:#80603d}
.mobile-nav{background:#fff;box-shadow:0 10px 28px rgba(42,32,19,.12)}
.btn-gold{color:#221a11;background:linear-gradient(135deg,#ead7ad,#d1ae75 54%,#bb9356)}
.btn-outline-gold{color:#6f512b}
.btn-outline-gold:hover{color:#24180a;background:#e0c28d}
.link-gold:hover{color:#4f3920}
/* Photo-led blocks intentionally remain dark with light text over the unmodified images. */
.hero,.services,.trio-review,.trio-community{color:#fff}
.hero .eyebrow,.services .eyebrow,.trio-review .eyebrow,.trio-community .eyebrow{color:#e9c88f}

ver);font-size:9px;text-transform:uppercase;letter-spacing:.12em}.detail-specs dd{font-size:12px;margin:5px 0 0}.detail-highlights{border-top:1px solid var(--border);padding-top:15px}.detail-highlights ul{padding-left:17px;font-size:12px;line-height:1.9}.detail-buttons{display:flex;flex-direction:column;gap:10px;margin-top:20px}.toast{position:fixed;z-index:120;bottom:22px;right:24px;max-width:350px;background:#26231e;border:1px solid var(--champagne);color:var(--ivory);padding:14px 22px;box-shadow:0 6px 30px #0009;font-size:12px}.legal-copy{text-align:left}.legal-copy h2{font-size:33px}.legal-copy p{color:var(--silver)}

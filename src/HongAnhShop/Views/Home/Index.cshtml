ifestyle":"Đường trường","collection":"Di sản Ý","highlights":["Gói Assetto Fiorano","Màu Rosso Imola","Hệ thống treo Multimatic"]},{"id":"sto","make":"Lamborghini","model":"Huracán STO","year":2023,"body":"track","edition":"1 trong 300","price":31500000000,"asset":"carGrey","gallery":["carGrey","carBlue","carSilver"],"power":"640 mã lực","engine":"V10 5.2L","gearbox":"Ly hợp kép 7 cấp","mileage":2500,"condition":"Tốt","location":"Hà Nội","lifestyle":"Thể thao","collection":"Di sản Ý","highlights":["Nắp capo Cofango","Vây cá mập","Lốp Bridgestone Potenza"]},{"id":"senna","make":"McLaren","model":"Senna","year":2022,"body":"limited","edition":"1 trong 500","price":82000000000,"asset":"carBlue","gallery":["carBlue","carGrey","hero1"],"power":"800 mã lực","engine":"V8 4.0L Twin-Turbo","gearbox":"SSG 7 cấp","mileage":1100,"condition":"Xuất sắc","location":"Quốc tế","lifestyle":"Sưu tầm","collection":"Tinh hoa Anh Quốc","highlights":["Cửa kính dihedral","Khung carbon Monocage III","Chứng nhận MSO"]},{"id":"918","make":"Porsche","model":"918 Spyder","year":2015,"body":"limited","edition":"1 trong 918","price":72000000000,"asset":"carSilver","gallery":["carSilver","hero1","carGrey"],"power":"887 mã lực","engine":"V8 4.6L Hybrid","gearbox":"PDK 7 cấp","mileage":8400,"condition":"Xuất sắc","location":"TP. Hồ Chí Minh","lifestyle":"Sưu tầm","collection":"Kỹ thuật Đức","highlights":["Gói Weissach","Một chủ sở hữu","Bảo dưỡng tại Porsche Centre"]}];
</script>
<script>
(()=>{'use strict';
const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
const ASSETS=window.AURELIA_ASSETS||{};
const CAR_META=window.AURELIA_CAR_META||[];
let CARS=[];
let carsLoading=true, carsLoadError=false;
const TYPE={hypercar:'Siêu xe hiệu suất đỉnh cao',gt:'Xe thể thao đường trường',track:'Phiên bản đường đua',limited:'Phiên bản giới hạn'};
const LOCATIONS=['Hà Nội','TP. Hồ Chí Minh','Đà Nẵng','Quốc tế'];
const LIFESTYLES=['Thể thao','Đường trường','Sưu tầm','Thượng lưu'];
const COLLECTIONS=['Di sản Ý','Tinh hoa Anh Quốc','Kỹ thuật Đức','Hypercar Pháp'];
const BRANDS=['Ferrari','Lamborghini','McLaren','Porsche','Bugatti','Aston Martin','Bentley','Rolls-Royce'];

// Single source of truth for inventory: GET /api/vehicles -> MySQL.
// The 12 old Home records only supply optional display specifications.
const norm=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
const knownBrand=s=>BRANDS.find(b=>norm(b)===norm(s));
const bodyFromCategory=c=>{
  const t=norm(c);
  if(t.includes('hypercar'))return 'hypercar';
  if(t.includes('gioi han')||t.includes('limited'))return 'limited';
  if(t.includes('duong dua')||t.includes('track'))return 'track';
  return 'gt';
};
function fromVehicle(p){
  if(!p||!Number.isSafeInteger(Number(p.id))||Number(p.id)<=0)return null;
  const name=String(p.name||'').trim();
  if(!name)return null;
  const plainName=name.replace(/\s*\((?:19|20)\d{2}\)\s*$/,'').trim();
  const yr=name.match(/\b(?:19|20)\d{2}\b/);
  const old=CAR_META.find(c=>norm(c.make+' '+c.model)===norm(plainName));
  const category=String(p.make||'').trim();
  const nameBrand=BRANDS.find(b=>norm(plainName).startsWith(norm(b)+' '));
  const make=old?.make||knownBrand(category)||nameBrand||category||'AURELIA';
  const model=old?.model||(norm(plainName).startsWith(norm(make)+' ')?plainName.slice(make.length).trim():plainName);
  const mainImage=String(p.imageUrl||'').trim();
  // New vehicles can have only one image until the gallery editor is implemented.
  const gallery=mainImage?[mainImage,...(old?.gallery||[])]:old?.gallery||['carSilver'];
  return {
    ...(old||{}),
    id:String(p.id), dbId:Number(p.id),
    make,model,
    year:old?.year||(yr?Number(yr[0]):''),
    body:old?.body||bodyFromCategory(category),
    edition:old?.edition||'Bộ sưu tập AURELIA',
    price:Number(p.price)||0, stock:Math.max(0,Number(p.stock)||0),
    description:String(p.description||''),
    asset:mainImage||old?.asset||'carSilver',gallery,
    power:old?.power||'Chưa cập nhật',engine:old?.engine||'Chưa cập nhật',
    gearbox:old?.gearbox||'Chưa cập nhật',mileage:old?.mileage??0,
    condition:old?.condition||'Chưa cập nhật',location:old?.location||'Chưa cập nhật',
    lifestyle:old?.lifestyle||'Thể thao',collection:old?.collection||'Bộ sưu tập AURELIA',
    highlights:old?.highlights||[]
  };
}
function updateCarSelect(){
  const selectEl=$('#inline-inquiry select[name="car"]');
  if(selectEl)selectEl.innerHTML='<option value="">Chọn mẫu xe</option>'+CARS.map(c=>`<option value="${esc(c.make+' '+c.model)}">${esc(c.make+' '+c.model)}</option>`).join('');
}
async function loadVehicles(){
  carsLoading=true;carsLoadError=false;renderCars();
  try{
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(),12000);
    let response;
    try{response=await fetch('/api/vehicles',{headers:{'Accept':'application/json'},cache:'no-store',signal:controller.signal});}
    finally{clearTimeout(timer);}
    if(!response.ok)throw new Error('API HTTP '+response.status);
    const data=await response.json();
    if(!Array.isArray(data))throw new Error('Dinh dang API khong hop le');
    CARS=data.map(fromVehicle).filter(Boolean);
    window.AURELIA_CARS=CARS;
  }catch(error){
    CARS=[]; window.AURELIA_CARS=[];carsLoadError=true;
    console.error('AURELIA: Khong tai duoc xe tu MySQL:',error);
  }finally{
    carsLoading=false;renderFilters();renderCars();updateCarSelect();
  }
}

const PRICE_RANGES=[['all','Mọi mức giá',0,Infinity],['lt30','Dưới 30 tỷ',0,30e9],['30-60','30 – 60 tỷ',30e9,60e9],['60-100','60 – 100 tỷ',60e9,100e9],['gt100','Trên 100 tỷ',100e9,Infinity]];
const SERVICES=[
['Tư vấn mua xe riêng','Tiếp cận những mẫu xe đặc biệt và xe phiên bản giới hạn.','Chuyên gia riêng đồng hành từ khâu tìm kiếm, thẩm định lịch sử xe đến đàm phán, giúp bạn tiếp cận những mẫu xe không công bố rộng rãi.'],
['Vận chuyển toàn cầu','Dịch vụ vận chuyển chuyên biệt, an toàn và tận nơi.','Xe được vận chuyển bằng container kín hoặc đường hàng không, có bảo hiểm toàn phần và bàn giao tận nơi theo lịch của bạn.'],
['Giải pháp tài chính','Phương án tài chính linh hoạt và riêng tư.','Kết nối với các đối tác tài chính để xây dựng phương án sở hữu linh hoạt, bảo mật và phù hợp với kế hoạch tài sản của bạn.'],
['Quản lý bộ sưu tập','Lưu trữ, bảo dưỡng và chăm sóc siêu xe.','Kho lưu trữ kiểm soát nhiệt độ, lịch bảo dưỡng chính hãng và báo cáo định kỳ cho từng chiếc xe trong bộ sưu tập.'],
['Cá nhân hóa độc quyền','Tư vấn những cấu hình và phiên bản riêng biệt.','Làm việc trực tiếp với các chương trình cá nhân hóa của hãng để tạo nên chiếc xe mang dấu ấn riêng của bạn.'] ];
const REVIEWS=[['Dịch vụ hoàn hảo, khả năng tiếp cận vượt trội và sự kín đáo hiếm có. AURELIA định nghĩa lại trải nghiệm mua siêu xe.','J. M.'],['Từ lúc tư vấn đến khi nhận xe tại Đà Nẵng, mọi chi tiết đều được chăm chút tỉ mỉ và riêng tư.','T. H.'],['Họ tìm được đúng chiếc xe sưu tầm tôi mong muốn suốt nhiều năm — một trải nghiệm thật sự xứng tầm.','L. A.']];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=n=>Number(n)>=1e9 ? `${(Number(n)/1e9).toLocaleString('vi-VN',{maximumFractionDigits:2})} tỷ VNĐ`:`${Number(n).toLocaleString('vi-VN')} VNĐ`;
// Car photos use image_url from MySQL; embedded photos remain available for banners/gallery.
const img=id=>{
  if(typeof id==='string' && (/^https?:\/\//i.test(id)||id.startsWith('/images/')))return id;
  return ASSETS[id]||ASSETS.carSilver||'';
};
const assetOf=c=>img(c.asset||'carSilver');
const $set=(sel,html)=>{const el=$(sel);if(el)el.innerHTML=html};
let slide=0,review=0,activeTab=0,filters={make:'',model:'',price:'all',body:'',location:'',lifestyle:'',collection:''};
let selectedCar=null,modalMode='',currentGallery=0;
let favorites=[];try{let f=JSON.parse(localStorage.getItem('aurelia-favorites')||'[]');favorites=Array.isArray(f)?f:[]}catch{}
function toast(msg){const t=$('#toast');t.textContent=msg;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>{t.hidden=true},3300)}
function applyAssets(){ $$('[data-image]').forEach(e=>{e.src=img(e.dataset.image);}); }
function scrollToSection(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'});}
function showSlide(idx){const arr=$$('.hero-slide');slide=(idx+arr.length)%arr.length;arr.forEach((el,i)=>el.classList.toggle('active',i===slide));$$('.hero-num').forEach((e,i)=>e.classList.toggle('active',i===slide));const titles=[['Đẳng cấp vượt chuẩn mực','Siêu xe đẳng cấp','cho cuộc sống','phi thường'],['Tuyển chọn độc quyền','Nghệ thuật','của tốc độ','và tinh hoa'],['Dịch vụ toàn cầu','Hành trình','riêng tư','không giới hạn']];const s=titles[slide];$set('#hero-eyebrow',esc(s[0]));$set('#hero-heading',s.slice(1).map(x=>`<span style="display:block">${esc(x)}</span>`).join(''));}
let heroTimer=null;function resetHeroTimer(){clearInterval(heroTimer);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)heroTimer=setInterval(()=>showSlide(slide+1),7000)}
function modelsFor(make){return [...new Set(CARS.filter(c=>!make||c.make===make).map(c=>c.model))]}
function opts(entries,value){return entries.map(([id,title])=>`<option value="${esc(id)}" ${id===value?'selected':''}>${esc(title)}</option>`).join('')}
function select(label,key,entries){return `<label class="select-wrap"><span>${esc(label)}</span><select data-filter="${key}" aria-label="${esc(label)}">${opts(entries,filters[key])}</select></label>`}
function renderModels(){const e=$('[data-filter="model"]');if(e){e.innerHTML=opts([['','Tất cả dòng xe'],...modelsFor(filters.make).map(m=>[m,m])],filters.model)}}
function renderFilters(){const p=$('#filter-container');if(activeTab===0){p.innerHTML=`<form id="vehicle-filter-form" class="filters">${select('Hãng xe','make',[['','Tất cả hãng'],...[...new Set(CARS.map(c=>c.make))].sort((a,b)=>a.localeCompare(b,'vi')).map(x=>[x,x])])}${select('Dòng xe','model',[['','Tất cả dòng xe'],...modelsFor(filters.make).map(x=>[x,x])])}${select('Khoảng giá','price',PRICE_RANGES.map(r=>[r[0],r[1]]))}${select('Kiểu dáng','body',[['','Mọi kiểu dáng'],...Object.entries(TYPE)])}${select('Địa điểm','location',[['','Toàn cầu'],...LOCATIONS.map(x=>[x,x])])}<button class="btn-gold" type="submit">Tìm kiếm</button></form>`;p.querySelectorAll('select[data-filter]').forEach(sel=>sel.addEventListener('change',()=>{filters[sel.dataset.filter]=sel.value;if(sel.dataset.filter==='make'){filters.model='';renderModels()}}));p.querySelector('form').addEventListener('submit',e=>{e.preventDefault();renderCars();scrollToSection('sieu-xe')});}
else{const [key,entries]=activeTab===1?['body',Object.entries(TYPE)]:activeTab===2?['lifestyle',LIFESTYLES.map(x=>[x,x])]:['collection',COLLECTIONS.map(x=>[x,x])];p.innerHTML=`<div class="filter-chips">${entries.map(([v,label])=>`<button class="filter-chip ${filters[key]===v?'selected':''}" data-key="${key}" data-value="${esc(v)}">${esc(label)}</button>`).join('')}</div>`;p.querySelectorAll('.filter-chip').forEach(btn=>btn.addEventListener('click',()=>{const k=btn.dataset.key,v=btn.dataset.value;filters={make:'',model:'',price:'all',body:'',location:'',lifestyle:'',collection:''};filters[k]=v;renderFilters();renderCars();scrollToSection('sieu-xe')}))}}
function filteredCars(){const range=PRICE_RANGES.find(r=>r[0]===filters.price)||PRICE_RANGES[0];return CARS.filter(c=>(!filters.make||c.make===filters.make)&&(!filters.model||c.model===filters.model)&&c.price>=range[2]&&c.price<range[3]&&(!filters.body||c.body===filters.body)&&(!filters.location||c.location===filters.location)&&(!filters.lifestyle||c.lifestyle===filters.lifestyle)&&(!filters.collection||c.collection===filters.collection))}
function isFiltered(){return Object.entries(filters).some(([k,v])=>v&&!(k==='price'&&v==='all'))}
function resetFilters(){filters={make:'',model:'',price:'all',body:'',location:'',lifestyle:'',collection:''};renderFilters();renderCars()}
function renderCars(){const cars=filteredCars();$set('#results-eyebrow',isFiltered()?'Kết quả tìm kiếm':'Siêu xe nổi bật');$set('#results-desc',isFiltered()?`Tìm thấy ${cars.length} mẫu xe phù hợp với tiêu chí của bạn.`:'Bộ sưu tập những mẫu siêu xe hiệu suất cao, thiết kế tinh xảo và mang giá trị sưu tầm đặc biệt.');$set('#reset-label',isFiltered()?'Xóa bộ lọc':'Xem toàn bộ siêu xe');$set('#cars-count',String(cars.length));const viewport=$('#cars-list');
if(carsLoading){viewport.innerHTML='<div class="empty-state" role="status"><h3>Đang tải bộ sưu tập...</h3><p>AURELIA đang đồng bộ siêu xe từ MySQL.</p></div>';return;}
if(carsLoadError){viewport.innerHTML='<div class="empty-state" role="alert"><h3>Chưa thể tải danh sách xe</h3><p>Không kết nối được dữ liệu sản phẩm. Vui lòng thử lại.</p><button type="button" class="btn-outline-gold" id="reload-vehicles">Tải lại</button></div>';$('#reload-vehicles').addEventListener('click',loadVehicles);return;}
if(!cars.length){viewport.innerHTML=`<div class="empty-state"><h3>Không tìm thấy siêu xe phù hợp</h3><p>Hãy thử điều chỉnh bộ lọc hoặc liên hệ chuyên gia để tìm xe theo yêu cầu.</p><button type="button" class="btn-outline-gold" id="no-results-reset">Xóa bộ lọc</button></div>`;$('#no-results-reset').addEventListener('click',resetFilters);return}
viewport.innerHTML=cars.map(c=>`<article class="car-card" tabindex="0" role="button" aria-label="Xem chi tiết ${esc(c.make)} ${esc(c.model)}" data-car="${esc(c.id)}"><div class="car-pic"><img alt="${esc(c.make+' '+c.model)}" src="${esc(assetOf(c))}" loading="lazy"/><button type="button" class="fav ${favorites.includes(c.id)?'on':''}" data-fav="${esc(c.id)}" aria-label="${favorites.includes(c.id)?'Bỏ khỏi yêu thích':'Thêm vào yêu thích'}">${favorites.includes(c.id)?'♥':'♡'}</button></div><div class="car-details"><h3>${esc([c.year,c.make,c.model].filter(Boolean).join(' '))}</h3><p class="subtitle">${esc(TYPE[c.body]||'Siêu xe')} | ${esc(c.edition)}</p><p class="price">${fmt(c.price)}</p><p class="stock-label ${c.stock>0?'available':'sold-out'}">${c.stock>0?'Còn '+c.stock+' xe':'Hết hàng'}</p></div></article>`).join('');
viewport.querySelectorAll('[data-car]').forEach(el=>{el.addEventListener('click',()=>openCar(el.dataset.car));el.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();openCar(el.dataset.car)}})});viewport.querySelectorAll('[data-fav]').forEach(btn=>btn.addEventListener('click',ev=>{ev.stopPropagation();toggleFav(btn.dataset.fav)}));}
function toggleFav(id){if(favorites.includes(id)){favorites=favorites.filter(x=>x!==id);toast('Đã bỏ khỏi danh sách yêu thích')}else{favorites.push(id);toast('Đã lưu vào danh sách yêu thích')}try{localStorage.setItem('aurelia-favorites',JSON.stringify(favorites))}catch{}renderCars();if(selectedCar?.id===id)openCar(id)}
function displayModal(inner,wide=false){const wrap=$('#modal-host');wrap.innerHTML=`<div class="modal-backdrop" id="active-backdrop"><div class="modal-frame ${wide?'wide':''}" role="dialog" aria-modal="true" aria-label="Cửa sổ thông tin"><button type="button" class="modal-close" id="modal-close" aria-label="Đóng">×</button>${inner}</div></div>`;document.body.classList.add('modal-open');$('#modal-close').addEventListener('click',closeModal);$('#active-backdrop').addEventListener('click',e=>{if(e.target.id==='active-backdrop')closeModal()});}
function closeModal(){document.body.classList.remove('modal-open');$set('#modal-host','');selectedCar=null}
function openInfo(title,body){selectedCar=null;displayModal(`<div class="modal-copy"><h2 class="display">${esc(title)}</h2><p>${esc(body)}</p><button type="button" class="btn-gold" data-modal-close>Đã hiểu</button></div>`);$('[data-modal-close]').addEventListener('click',closeModal)}
function openCar(id){const c=CARS.find(c=>c.id===id);if(!c)return;selectedCar=c;currentGallery=0;const specs=[['Hãng xe',c.make],['Năm sản xuất',String(c.year)],['Công suất',c.power],['Động cơ',c.engine],['Hộp số',c.gearbox],['Số km đã đi',Number(c.mileage).toLocaleString('vi-VN')+' km'],['Tình trạng',c.condition],['Địa điểm',c.location]];
const content=`<div class="detail-grid"><div><img class="detail-image-main" id="detail-main" src="${esc(img(c.gallery?.[0]||c.asset))}" alt="${esc(c.make+' '+c.model)}"/><div class="gallery" id="gallery-items">${(c.gallery||[c.asset]).map((asset,i)=>`<button data-gallery="${i}" class="${i===0?'active':''}" aria-label="Xem ảnh ${i+1}"><img src="${esc(img(asset))}" alt="Góc nhìn ${i+1}"/></button>`).join('')}</div></div><div class="detail-panel"><p class="eyebrow">${esc(TYPE[c.body]||'Siêu xe')} · ${esc(c.edition)}</p><h2 class="display">${esc(c.make+' '+c.model)}</h2><p class="price">${fmt(c.price)}</p><p class="stock-label ${c.stock>0?'available':'sold-out'}">${c.stock>0?'Còn '+c.stock+' xe':'Hết hàng — chưa nhận đặt mua'}</p><p style="font-size:9px;letter-spacing:.1em;color:var(--silver)">Giá tham khảo từ dữ liệu AURELIA</p>${c.description?`<p style="line-height:1.7;color:var(--silver);font-size:12px">${esc(c.description)}</p>`:''}<dl class="detail-specs">${specs.map(([k,v])=>`<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl><div class="detail-highlights"><p class="eyebrow">Thông tin nổi bật</p><ul>${(c.highlights||[]).map(h=>`<li>${esc(h)}</li>`).join('')}</ul></div><div class="detail-buttons"><button class="btn-gold" id="detail-add-cart" ${c.stock<=0?'disabled title="Xe đã hết hàng"':''}>Thêm vào giỏ xe</button><button class="btn-outline-gold" id="detail-inquire">Yêu cầu tư vấn</button><button class="btn-outline-gold" id="detail-book" ${c.stock<=0?'disabled title="Xe hiện hết hàng"':''}>Đặt lịch xem xe</button><button class="link-gold" id="detail-favorite">${favorites.includes(id)?'♥ Đã lưu — bỏ khỏi yêu thích':'♡ Lưu xe yêu thích'}</button></div></div></div>`;
displayModal(content,true);$$('[data-gallery]').forEach(btn=>btn.addEventListener('click',()=>{$('#detail-main').src=img(c.gallery[Number(btn.dataset.gallery)]);$$('[data-gallery]').forEach(b=>b.classList.toggle('active',b===btn))}));$('#detail-add-cart').addEventListener('click',()=>{
  if(c.stock<=0||!Number.isSafeInteger(c.dbId)||c.dbId<=0){toast('Xe đã hết hàng hoặc không có mã sản phẩm hợp lệ');return}
  const form=$('#aurelia-cart-add-form');
  if(!form){toast('Không thể mở giỏ xe. Vui lòng tải lại trang.');return}
  form.querySelector('input[name="productId"]').value=String(c.dbId);
  form.submit();
 });
 $('#detail-inquire').addEventListener('click',()=>openForm('inquire',`${c.make} ${c.model}`));$('#detail-book').addEventListener('click',()=>openForm('book',`${c.make} ${c.model}`));$('#detail-favorite').addEventListener('click',()=>toggleFav(c.id));}
function openService(idx){const s=SERVICES[idx];if(!s)return;const content=`<div class="modal-copy legal-copy"><p class="eyebrow">Dịch vụ VIP</p><div style="display:flex;flex-wrap:wrap;gap:7px;margin:18px 0">${SERVICES.map((s,i)=>`<button data-service-tab="${i}" class="filter-chip ${i===idx?'selected':''}">${esc(s[0])}</button>`).join('')}</div><h2 class="display">${esc(s[0])}</h2><p>${esc(s[2])}</p><button id="service-inquire" class="btn-gold">Yêu cầu tư vấn</button></div>`;displayModal(content);$$('[data-service-tab]').forEach(btn=>btn.addEventListener('click',()=>openService(Number(btn.dataset.serviceTab))));$('#service-inquire').addEventListener('click',()=>openForm('inquire'));}
function fields(){return [
{name:'name',label:'Họ và tên *',placeholder:'Nguyễn Văn A'},
{name:'phone',label:'Số điện thoại *',placeholder:'0901 234 567',type:'tel'},
{name:'email',label:'Email *',placeholder:'ten@@example.com',type:'email'},
{name:'car',label:'Mẫu xe quan tâm *',select:[['','Chọn mẫu xe'],...CARS.map(c=>[`${c.make} ${c.model}`,`${c.make} ${c.model}`])]},
{name:'date',label:'Ngày mong muốn xem xe',type:'date'},
{name:'method',label:'Phương thức liên hệ',select:['Điện thoại','Email','Zalo','Gặp trực tiếp'].map(x=>[x,x])},
{name:'message',label:'Nội dung yêu cầu',textarea:true,placeholder:'Chia sẻ mong muốn của bạn...',full:true}];}
function formHTML(mode='inquire',vehicle=''){return `<form class="inquiry-panel" id="inquiry-form" novalidate data-mode="${esc(mode)}"><div class="full"><p class="eyebrow">${mode==='book'?'Đặt lịch riêng':'Tư vấn riêng'}</p><h2 class="display">${mode==='book'?'Đặt lịch xem xe':'Yêu cầu tư vấn'}</h2></div>${fields().map(f=>`<label class="${f.full?'full':''}"><span class="field-label">${f.label}${f.name==='date'&&mode==='book'?' *':''}</span>${f.select?`<select name="${f.name}" class="field">${f.select.map(([v,l])=>`<option value="${esc(v)}" ${v===(f.name==='car'?vehicle:f.name==='method'?'Điện thoại':'')?'selected':''}>${esc(l)}</option>`).join('')}</select>`:f.textarea?`<textarea class="field" name="${f.name}" rows="3" placeholder="${esc(f.placeholder)}"></textarea>`:`<input class="field" type="${f.type||'text'}" name="${f.name}" placeholder="${esc(f.placeholder||'')}" ${f.type==='date'?'style="color-scheme:dark"':''}/>`}<span class="form-error" data-error="${f.name}"></span></label>`).join('')}<button class="btn-gold full" type="submit">${mode==='book'?'Đặt lịch xem xe':'Gửi yêu cầu tư vấn'}</button></form>`}
function formInit(scope,mode){const f=scope.querySelector('#inquiry-form');if(!f)return;f.addEventListener('submit',ev=>{ev.preventDefault();const d=new FormData(f),v=Object.fromEntries(d);const errs={};const phone=String(v.phone||'').replace(/[\s.]/g,'');if(String(v.name||'').trim().length<2)errs.name='Vui lòng nhập họ và tên.';if(!/^(\+?84|0)\d{9,10}$/.test(phone))errs.phone='Số điện thoại không hợp lệ.';if(!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(v.email||'').trim()))errs.email='Email không hợp lệ.';if(!v.car)errs.car='Vui lòng chọn mẫu xe quan tâm.';if(mode==='book'){if(!v.date)errs.date='Vui lòng chọn ngày xem xe.';else if(new Date(String(v.date)+'T00:00:00')<new Date(new Date().toDateString()))errs.date='Ngày xem xe phải từ hôm nay trở đi.'}if(String(v.message||'').length>1000)errs.message='Nội dung tối đa 1000 ký tự.';
f.querySelectorAll('[data-error]').forEach(el=>{el.textContent=errs[el.dataset.error]||''});if(Object.keys(errs).length){const inp=f.querySelector(`[name="${Object.keys(errs)[0]}"]`);inp?.focus();return}scope.innerHTML=`<div class="form-complete"><p class="eyebrow">Bản xem trước</p><h2 class="display">Thông tin hợp lệ</h2><p>Đây là giao diện demo — yêu cầu của bạn <strong>chưa được gửi</strong> tới đội ngũ AURELIA và chưa được lưu lại. Chức năng gửi sẽ hoạt động sau khi kết nối backend.</p><button class="btn-gold" id="form-done">Đóng</button></div>`;scope.querySelector('#form-done').addEventListener('click',()=>{if(scope.id==='inline-inquiry'){scope.innerHTML=formHTML('inquire');formInit(scope,'inquire')}else closeModal()});});}
function openForm(mode='inquire',vehicle=''){selectedCar=null;displayModal(`<div id="modal-form">${formHTML(mode,vehicle)}</div>`);formInit($('#modal-form'),mode)}
function renderReview(){const r=REVIEWS[review];$set('#review-quote','“'+esc(r[0])+'”');$set('#review-author',esc(r[1]))}
function init(){applyAssets();showSlide(0);resetHeroTimer();$('#hero-next').addEventListener('click',()=>{showSlide(slide+1);resetHeroTimer()});$('#hero-prev').addEventListener('click',()=>{showSlide(slide-1);resetHeroTimer()});$$('.hero-num').forEach((el,i)=>el.addEventListener('click',()=>{showSlide(i);resetHeroTimer()}));
$('#mobile-menu').addEventListener('click',()=>{$('#mobile-nav').classList.toggle('open');$('#mobile-menu').setAttribute('aria-expanded',$('#mobile-nav').classList.contains('open'))});$$('#mobile-nav a').forEach(a=>a.addEventListener('click',()=>$('#mobile-nav').classList.remove('open')));
$('#hero-browse').addEventListener('click',()=>scrollToSection('sieu-xe'));$$('[data-inquire]').forEach(b=>b.addEventListener('click',()=>openForm('inquire')));$$('[data-go-search]').forEach(b=>b.addEventListener('click',()=>scrollToSection('tim-kiem')));
$$('.search-tab').forEach((b,i)=>b.addEventListener('click',()=>{activeTab=i;$$('.search-tab').forEach(x=>x.classList.toggle('active',x===b));renderFilters()}));$('#view-all').addEventListener('click',()=>{resetFilters();scrollToSection('sieu-xe')});$('#reset-cars').addEventListener('click',()=>{resetFilters();scrollToSection('sieu-xe')});$$('[data-car-scroll]').forEach(btn=>btn.addEventListener('click',()=>$('#cars-list').scrollBy({left:Number(btn.dataset.carScroll)*$('#cars-list').clientWidth*.8,behavior:'smooth'})));
$$('[data-service]').forEach(btn=>btn.addEventListener('click',()=>openService(Number(btn.dataset.service))));$('#services-all').addEventListener('click',()=>openService(0));
$$('[data-review]').forEach(btn=>btn.addEventListener('click',()=>{review=(review+Number(btn.dataset.review)+REVIEWS.length)%REVIEWS.length;renderReview()}));$('#community-open').addEventListener('click',()=>openInfo('Cộng đồng AURELIA','Cộng đồng chủ nhân AURELIA với các sự kiện riêng tư và hành trình lái xe độc quyền đang được chuẩn bị. Hãy để lại thông tin tư vấn để nhận lời mời sớm nhất.'));
$$('[data-legal]').forEach(btn=>btn.addEventListener('click',()=>openInfo(btn.dataset.legal,'Nội dung đang được cập nhật. Vui lòng liên hệ đội ngũ AURELIA để biết thêm chi tiết.')));
$$('[data-social]').forEach(btn=>btn.addEventListener('click',e=>{e.preventDefault();openInfo('Mạng xã hội AURELIA','Kênh mạng xã hội chính thức đang được cập nhật.')}));$('#back-top').addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#active-backdrop'))closeModal()});
renderFilters();renderCars();renderReview();updateCarSelect();formInit($('#inline-inquiry'),'inquire');$('#cars-count').hidden=true;loadVehicles();
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();

</script>

<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>


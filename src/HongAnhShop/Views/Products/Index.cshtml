
@model List<HongAnhShop.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm HongAnhShop";
}

<div class="container py-5">
    <h1 class="mb-3">Sản phẩm HongAnhShop</h1>

    <p>
        Danh sách sản phẩm được lấy trực tiếp từ MySQL.
    </p>

    <div class="mb-4">
        <a asp-controller="Cart"
           asp-action="Index"
           class="btn btn-outline-primary">
            🛒 Xem giỏ hàng
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">

        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @product.Name
                        </h5>

                        <p class="text-muted">
                            @product.Category
                        </p>

                        <p>
                            @product.Description
                        </p>

                        <h5 class="text-danger">
                            @product.Price.ToString("N0") VNĐ
                        </h5>

                        <p>
                            Tồn kho: @product.Stock
                        </p>

                        @if (product.Stock > 0)
                        {
                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post"
                                  class="mt-auto">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@product.Id" />

                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    🛒 Thêm vào giỏ hàng
                                </button>

                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary w-100 mt-auto"
                                    disabled>
                                Hết hàng
                            </button>
                        }

                    </div>
                </div>
            </div>
        }

    </div>
</div>

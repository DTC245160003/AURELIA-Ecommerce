@{
    Layout = null;
    ViewData["Title"] = "Đặt xe thành công | AURELIA";
    string code = ViewBag.OrderCode as string ?? "";
}
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
:root{--bg:#0b0e10;--gold:#c8aa78;--gold2:#e8d1a7;--ink:#f3f0ea;--muted:#aeb1b3;--line:rgba(200,170,120,.27);--ok:#a4d1a9}
*{box-sizing:border-box}body{background:var(--bg);margin:0;color:var(--ink);font-family:Montserrat,"Segoe UI",Arial,sans-serif}a{color:inherit;text-decoration:none}.top{border-bottom:1px solid var(--line)}.top-inner{max-width:1100px;margin:auto;min-height:94px;padding:20px 25px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:30px "Times New Roman",serif;letter-spacing:6px;color:var(--gold2)}.nav{font-size:12px;color:var(--gold2);border:1px solid var(--line);padding:12px 16px;border-radius:6px}.wrap{max-width:870px;margin:7vh auto 12vh;padding:25px}.panel{border:1px solid var(--line);border-radius:15px;background:linear-gradient(140deg,#1b1d1f,#101213);text-align:center;padding:70px 30px}.symbol{width:76px;height:76px;margin:0 auto 28px;display:grid;place-items:center;border-radius:50%;border:1px solid var(--ok);color:var(--ok);font-size:38px}.eyebrow{color:var(--gold);font-size:11px;letter-spacing:3px;text-transform:uppercase}.panel h1{font:400 clamp(34px,5vw,56px) "Times New Roman",serif;margin:18px 0}.copy{color:var(--muted);font-size:14px;line-height:1.9;max-width:570px;margin:0 auto 30px}.code{border:1px solid var(--line);padding:19px;margin:0 auto 30px;max-width:590px;border-radius:9px;background:#0d0f11}.code label{display:block;font-size:11px;letter-spacing:2px;color:var(--muted);margin-bottom:11px}.code strong{font-family:monospace;color:var(--gold2);overflow-wrap:anywhere;font-weight:500;font-size:15px}.status{font-size:13px;color:var(--ok);margin-bottom:29px}.btns{display:flex;justify-content:center;flex-wrap:wrap;gap:12px}.btn{padding:16px 22px;background:var(--gold);border:1px solid var(--gold);border-radius:5px;color:#14110c;font-size:12px;font-weight:700;letter-spacing:.5px}.btn-outline{background:transparent;color:var(--gold2)}.footer{text-align:center;padding:25px;font-size:11px;color:var(--muted);border-top:1px solid var(--line)}
@@media(max-width:600px){.top-inner{flex-direction:column;align-items:flex-start}.wrap{margin:30px auto 50px;padding:15px}.panel{padding:46px 20px}.btn{width:100%;text-align:center}}
</style>

<style id="aurelia-light-style" media="not all">
/* AURELIA light cart and checkout */
:root{--bg:#f8f7f3;--panel:#fff;--panel2:#fff;--gold:#886638;--gold2:#76552e;
 --ink:#282520;--muted:#716a62;--line:#e4dccc;--bad:#a94444;--ok:#267344}
html{color-scheme:light}body{background:#f8f7f3;color:#282520}
.top,.header{background:#fff;border-color:#e8e0d4}
.brand{color:#806039}
.nav a,.top a,.back,.secondary{color:#78582d;border-color:#dbcbaa}
.nav a:hover,.back:hover,.secondary:hover{background:#f3e9d8}
.panel,.summary,.item{background:#fff;border-color:#e5ddce;box-shadow:0 12px 32px rgba(62,43,18,.055)}
.field input,.field textarea,.qty input,input:not([type=hidden]),textarea{background:#fff;color:#282520;border-color:#d6cbb9}
.field input::placeholder,.field textarea::placeholder{color:#81796d}
.qty input{color:#282520}
.thumb{background:linear-gradient(135deg,#f5ead8,#edeae4)}
.section-label,.price,.summary-total strong{color:#79592e}
.mini-btn{background:#fff;color:#755528}
.mini-btn:hover{background:#f5ebdc}
.remove,.validation{color:#ab4040}
.cta,.btn:not(.btn-outline){background:#8b6638;color:#fff;border-color:#8b6638}
.cta:hover,.btn:not(.btn-outline):hover{background:#735126;color:#fff}
.btn-outline{background:#fff;color:#78582d;border-color:#c9b28c}
.btn-outline:hover{background:#f2e7d5;color:#694923}
.code{background:#fff;border-color:#e2d7c5}
.note,.info{color:#716a62}
.info{background:#fbf7f0;border-color:#e5d8c2}
.notice{color:#286840}
.footer{border-color:#e8e0d4}

.stock-label.available{color:#237241}.stock-label.sold-out{color:#ad4242}
.summary-total strong,.amount{color:#785729}


</style>
<style id="aurelia-theme-toggle-style">

/* AURELIA THEME SWITCH CONTROL - fixed, does not affect car/banners photos */
#aurelia-theme-toggle {
  all: unset !important;
  position: fixed !important;
  z-index: 2147483000 !important;
  left: 20px !important;
  bottom: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  box-sizing: border-box !important;
  min-height: 44px !important;
  padding: 11px 17px !important;
  border: 1px solid #bda06e !important;
  border-radius: 999px !important;
  background: #18191b !important;
  color: #f3e1c1 !important;
  font: 600 12px/1.2 'Segoe UI', Arial, sans-serif !important;
  letter-spacing: 0 !important;
  white-space: nowrap !important;
  text-decoration: none !important;
  -webkit-text-fill-color: currentColor !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
  transition: background-color .2s,color .2s,transform .15s !important;
}
#aurelia-theme-toggle:hover { transform: translateY(-2px) !important; }
#aurelia-theme-toggle:focus-visible { outline: 3px solid #c8a56a !important; outline-offset: 3px !important; }
#aurelia-theme-toggle .aurelia-theme-icon { font-size: 20px !important; line-height: 1 !important; color: inherit !important; }
#aurelia-theme-toggle .aurelia-theme-label { color: inherit !important; font: inherit !important; }
html[data-aurelia-theme="light"] #aurelia-theme-toggle {
  background: #ffffff !important;
  color: #72552c !important;
  border-color: #cbb17f !important;
  box-shadow: 0 8px 22px rgba(72,51,18,.12) !important;
}
@@media(max-width: 520px) {
  #aurelia-theme-toggle { left: 12px !important; bottom: 12px !important; padding: 9px 13px !important; min-height: 42px !important; }
}

</style>

<script id="aurelia-theme-boot">
// Apply the saved choice before the page is painted (default: original dark theme).
(function () {
  var mode = 'dark';
  try {
    if (window.localStorage.getItem('aurelia.theme') === 'light') mode = 'light';
  } catch (_) { /* Browsers blocking storage still support temporary switching. */ }
  document.documentElement.setAttribute('data-aurelia-theme', mode);
  var lightStyle = document.getElementById('aurelia-light-style');
  if (lightStyle) lightStyle.media = mode === 'light' ? 'all' : 'not all';
})();
</script>

</head>
<body>
<header class="top"><div class="top-inner"><a class="brand" href="/">AURELIA</a><a class="nav" href="/">Trang chủ</a></div></header>
<main class="wrap"><section class="panel"><div class="symbol">✓</div><p class="eyebrow">REQUEST RECEIVED</p><h1>Đặt xe thành công</h1><p class="copy">Yêu cầu đặt xe đã được lưu vào hệ thống AURELIA. Đội ngũ phụ trách sẽ liên hệ theo thông tin bạn cung cấp để hỗ trợ bước tiếp theo.</p><div class="code"><label>MÃ ĐƠN ĐẶT XE</label><strong>@code</strong></div><p class="status">● Trạng thái: Chờ xử lý (pending)</p><div class="btns"><a href="/#sieu-xe" class="btn">TIẾP TỤC KHÁM PHÁ</a><a href="/Cart" class="btn btn-outline">XEM GIỎ HÀNG</a>@if (User.IsInRole("User")) { <a href="/Account/MyOrders" class="btn btn-outline">ĐƠN HÀNG CỦA TÔI</a> }</div><p class="copy" style="font-size:12px;margin-top:28px;margin-bottom:0">Đây là yêu cầu đặt xe; hệ thống chưa ghi nhận thanh toán tiền trực tuyến.</p></section></main>
<footer class="footer">AURELIA — CURATED MOTORING EXCELLENCE</footer>

<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>

</body>
</html>

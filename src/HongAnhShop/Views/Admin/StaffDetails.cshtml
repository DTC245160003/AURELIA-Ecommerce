@model HongAnhShop.Models.AdminStaffUserRow
@{
    Layout = null;
    ViewData["Title"] = "Phân quyền tài khoản | AURELIA";
    var isStaff = Model.Role == "Staff";
}
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
:root{--bg:#090a0b;--gold:#d2b47a;--gold2:#f0dbb2;--text:#f3f0e9;--muted:#a7a6a4;--line:rgba(210,180,122,.22)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,'Segoe UI',Arial,sans-serif}a{text-decoration:none;color:inherit}
.shell{display:flex;min-height:100vh}.sidebar{width:264px;background:#101113;border-right:1px solid var(--line);padding:36px 20px;flex-shrink:0}.brand{text-align:center;font:27px "Times New Roman",serif;letter-spacing:5px;color:var(--gold2)}.brand-sub{text-align:center;color:#999;letter-spacing:3px;font-size:10px;margin:9px 0 40px}.navtitle{padding:0 15px;color:#888;font-size:10px;letter-spacing:2px;margin-bottom:14px}.nav a{display:block;padding:14px 15px;margin:4px 0;color:#aba9a7;border-radius:9px;font-size:13px}.nav a:hover,.nav a.active{background:rgba(210,180,122,.11);color:var(--gold2)}
.main{flex:1;min-width:0;padding:37px 42px 70px}.topline{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:23px;margin-bottom:25px}.eyebrow{font-size:11px;letter-spacing:3px;color:var(--gold)}h1{font:normal clamp(30px,4vw,42px) "Times New Roman",serif;margin:12px 0}.subtitle{color:var(--muted);font-size:13px;line-height:1.7}.panel{background:linear-gradient(145deg,#1b1c1e,#111214);border:1px solid var(--line);border-radius:13px;padding:30px;max-width:930px}.info{font-size:12px;color:#bcb8b0;line-height:1.8}.field{display:grid;grid-template-columns:185px 1fr;gap:12px 18px;margin:0}.field dt{color:#a09e99;font-size:13px}.field dd{margin:0;overflow-wrap:anywhere;font-size:14px}.badge{display:inline-block;border-radius:30px;padding:6px 12px;font-size:12px}.badge.staff{background:#493c27;color:#f5dba3}.badge.user{background:#233b4e;color:#b3d9fa}.badge.yes{background:#173b29;color:#aeefc2}.badge.no{background:#48292c;color:#f4b0b0}
.btn{display:inline-flex;justify-content:center;align-items:center;cursor:pointer;padding:12px 20px;border-radius:8px;font:inherit;font-size:13px;border:1px solid var(--gold);color:var(--gold2);background:transparent;text-decoration:none}.btn:hover{background:var(--gold);color:#111}.btn.primary{background:var(--gold);color:#111}.btn.danger{border-color:#b97676;color:#f2afaf}.btn.danger:hover{background:#713d3d;color:white}.btn.light{border-color:#555;color:#ded9cd}.btn:disabled{opacity:.4;cursor:not-allowed}.actions{margin-top:30px;display:flex;align-items:center;flex-wrap:wrap;gap:12px}.alert{max-width:930px;margin:0 0 17px;border:1px solid #426b50;background:#1b3a2a;color:#c3efcd;padding:13px 18px;border-radius:8px;font-size:13px}.alert.error{border-color:#805151;background:#3a2223;color:#ffd0d0}.footer{max-width:930px;margin-top:23px;padding:18px;border:1px solid var(--line);border-radius:8px;color:#b7b4ac;line-height:1.8;font-size:13px}
@@media(max-width:800px){.sidebar{width:205px}.main{padding:25px}}@@media(max-width:670px){.shell{display:block}.sidebar{width:100%;padding:20px}.brand-sub{margin-bottom:16px}.navtitle{display:none}.nav{display:flex;flex-wrap:wrap}.nav a{padding:10px}.main{padding:25px 16px}.panel{padding:20px}.field{grid-template-columns:1fr;gap:4px}.field dd{margin-bottom:15px}}
</style>
<style id="aurelia-light-style" media="not all">
/* AURELIA light administration: color-only override */
:root{
 --bg:#f8f7f3;--nav:#fff;--panel:#fff;--panel2:#fbfaf7;
 --line:#e5dfd5;--gold:#876438;--gold2:#79572e;--gold-light:#79572e;
 --fg:#282520;--text:#282520;--muted:#706a62;
 --danger:#a33e3e;--ok:#247443
}
html{color-scheme:light}
body{background:#f8f7f3;color:#282520}
.sidebar{background:#ffffff;border-color:#e5dfd5;box-shadow:4px 0 25px rgba(71,52,24,.035)}
.brand,.logo{color:#806039}
.brand-sub,.sublogo,.nav-title,.navtitle,.side-label,.side-footer,.sidebar-note{color:#746f67}
.nav-link,.nav a,.side-nav a{color:#514a40}
.nav-link.active,.nav-link:hover,.nav a.active,.nav a:hover,.side-nav a.active,.side-nav a:hover{background:#f4ead9;color:#725329}
.nav-link.disabled{color:#8c857b}
.card,.metric,.stat,.panel,.info,form.editor{background:#fff;border-color:#e6dfd3;box-shadow:0 10px 26px rgba(75,53,24,.045)}
.table-wrap,.table-scroll{background:#fff;border-color:#e5dfd5}
table{background:#fff}
th{background:#f6f2ea;color:#75552b}
th,td{border-color:#e9e3db}
tbody tr:hover{background:#fbf7f0}
.brand,.metric .num,.stat .value,.card-status,.action,.amount,.code,.eyebrow{color:#856236}
.nav a,.nav-link,.side-nav a{transition:background .2s,color .2s}
.input,select,.field input,.field select,input:not([type=checkbox]):not([type=radio]):not([type=hidden]),textarea{
 background:#fff;color:#25221d;border-color:#d7cbbb
}
input::placeholder,textarea::placeholder{color:#827b70}
.btn,.pill-link,.action,.toolbar-links a{color:#75552d;border-color:#cbb58f;background:#fff}
.btn:hover,.pill-link:hover,.toolbar-links a:hover{background:#f2e8d7;color:#533c20}
.btn-primary,.btn.primary,button.primary,.btn-primary:hover,.btn.primary:hover{
 background:#88663a;color:#fff;border-color:#88663a
}
.btn.light{color:#5c554b;border-color:#bbb3a7}
.btn.danger,.btn-danger{color:#a33e3e;border-color:#dba4a4}
.btn.danger:hover,.btn-danger:hover{background:#a33e3e;color:#fff}
.btn[disabled]{opacity:.45}
.badge.yes,.badge.staff,.badge.user,.badge.no,.status,.status.pending,.status.confirmed,.status.completed,.status.cancelled{
 border-color:transparent
}
.badge.yes{background:#e3f5e9;color:#256d40}
.badge.no{background:#fce8e7;color:#9d3b3b}
.badge.staff{background:#f5ead5;color:#74501c}
.badge.user{background:#e5f0fa;color:#315e85}
.status{background:#fff2dc;color:#835a22;border-color:#e1c69b}
.status.confirmed{background:#e6f1fa;color:#2b5c85;border-color:#b9d6ec}
.status.completed{background:#e5f6e9;color:#23713f;border-color:#b8e2c4}
.status.cancelled{background:#fce8e7;color:#a13f40;border-color:#edc4c4}
.notice,.alert{background:#ebf7ed;color:#286b3d;border-color:#bfe2c7}
.notice.error,.alert.error,.errors{background:#fceceb;color:#a13b3b;border-color:#eac2bf}
.info,.footer{color:#666052}
.field dt,.detail dt{color:#71695d}
.photo{background:#f3eee6}
.pill{color:#267345;border-color:#9cccac}
.pill.off{color:#a23e3e;border-color:#d9aaaa}
@@media(max-width:760px){.sidebar{box-shadow:none}}

.info,.footer{color:#686056}
.btn.light{color:#5e5449;border-color:#c9c0b4}


</style>
<style id="aurelia-theme-toggle-style">

/* AURELIA THEME SWITCH CONTROL - fixed, does not affect car/banners photos */
#aurelia-theme-toggle {
  all: unset !important;
  position: fixed !important;
  z-index: 2147483000 !important;
  left: 20px !important;
  bottom: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  box-sizing: border-box !important;
  min-height: 44px !important;
  padding: 11px 17px !important;
  border: 1px solid #bda06e !important;
  border-radius: 999px !important;
  background: #18191b !important;
  color: #f3e1c1 !important;
  font: 600 12px/1.2 'Segoe UI', Arial, sans-serif !important;
  letter-spacing: 0 !important;
  white-space: nowrap !important;
  text-decoration: none !important;
  -webkit-text-fill-color: currentColor !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
  transition: background-color .2s,color .2s,transform .15s !important;
}
#aurelia-theme-toggle:hover { transform: translateY(-2px) !important; }
#aurelia-theme-toggle:focus-visible { outline: 3px solid #c8a56a !important; outline-offset: 3px !important; }
#aurelia-theme-toggle .aurelia-theme-icon { font-size: 20px !important; line-height: 1 !important; color: inherit !important; }
#aurelia-theme-toggle .aurelia-theme-label { color: inherit !important; font: inherit !important; }
html[data-aurelia-theme="light"] #aurelia-theme-toggle {
  background: #ffffff !important;
  color: #72552c !important;
  border-color: #cbb17f !important;
  box-shadow: 0 8px 22px rgba(72,51,18,.12) !important;
}
@@media(max-width: 520px) {
  #aurelia-theme-toggle { left: 12px !important; bottom: 12px !important; padding: 9px 13px !important; min-height: 42px !important; }
}

</style>

<script id="aurelia-theme-boot">
// Apply the saved choice before the page is painted (default: original dark theme).
(function () {
  var mode = 'dark';
  try {
    if (window.localStorage.getItem('aurelia.theme') === 'light') mode = 'light';
  } catch (_) { /* Browsers blocking storage still support temporary switching. */ }
  document.documentElement.setAttribute('data-aurelia-theme', mode);
  var lightStyle = document.getElementById('aurelia-light-style');
  if (lightStyle) lightStyle.media = mode === 'light' ? 'all' : 'not all';
})();
</script>

</head><body>
<div class="shell"><aside class="sidebar"><div class="brand">AURELIA</div><div class="brand-sub">ADMINISTRATION</div><div class="navtitle">QUẢN TRỊ HỆ THỐNG</div><nav class="nav" aria-label="Quản trị">
<a href="/Admin">◇ Tổng quan</a><a href="/Admin/Products">◇ Quản lý siêu xe</a><a href="/Admin/Orders">◇ Quản lý đơn hàng</a><a href="/Admin/Customers">◇ Quản lý khách hàng</a><a class="active" href="/Admin/Staff">✧ Phân quyền nhân viên</a><a href="/">↗ Xem website</a>
</nav></aside><main class="main">
<div class="topline"><div><div class="eyebrow">AURELIA / ACCOUNT PRIVILEGES</div><h1>@Model.FullName</h1><p class="subtitle">Cập nhật quyền truy cập của tài khoản #@Model.Id</p></div><a class="btn light" href="/Admin/Staff">← Danh sách tài khoản</a></div>
@if (TempData["StaffMessage"] is string message) { <div class="alert">@message</div> }
@if (TempData["StaffError"] is string error) { <div class="alert error">@error</div> }
<div class="panel"><div class="eyebrow" style="margin-bottom:24px">THÔNG TIN TÀI KHOẢN</div><dl class="field">
<dt>Mã tài khoản</dt><dd>#@Model.Id</dd>
<dt>Họ tên</dt><dd>@Model.FullName</dd>
<dt>Email</dt><dd>@(Model.Email ?? "Chưa cung cấp")</dd>
<dt>Số điện thoại</dt><dd>@(Model.Phone ?? "Chưa cung cấp")</dd>
<dt>Vai trò hiện tại</dt><dd><span class="badge @(isStaff ? "staff" : "user")">@(isStaff ? "Nhân viên (Staff)" : "Khách hàng (User)")</span></dd>
<dt>Trạng thái</dt><dd><span class="badge @(Model.IsActive ? "yes" : "no")">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</span></dd>
<dt>Ngày đăng ký</dt><dd>@Model.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</dd>
</dl>
<div class="actions">
@if (!isStaff && !Model.IsActive)
{
  <button class="btn" type="button" disabled>Không thể cấp quyền cho tài khoản đã khóa</button>
}
else
{
  <form method="post" action="/Admin/Staff/@Model.Id/Role" onsubmit="return confirm('@(isStaff ? "Thu hồi quyền Staff và chuyển tài khoản về User?" : "Cấp quyền Staff cho tài khoản này?")');">
  @Html.AntiForgeryToken()
  <input type="hidden" name="expectedRole" value="@Model.Role" />
  <input type="hidden" name="nextRole" value="@(isStaff ? "User" : "Staff")" />
  <button class="btn @(isStaff ? "danger" : "primary")" type="submit">@(isStaff ? "Thu hồi quyền Staff" : "Cấp quyền Staff")</button>
  </form>
}
<a href="/Admin/Staff" class="btn light">Quay lại</a>
</div></div>
<div class="footer"><strong style="color:var(--gold2)">Bảo mật</strong><div>Chỉ Admin có quyền đổi User ⇄ Staff. Mật khẩu không bị thay đổi. Sau khi vai trò đổi trong MySQL, cookie cũ không còn hợp lệ; người dùng phải đăng nhập lại.</div></div>
</main></div>
<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>

</body></html>

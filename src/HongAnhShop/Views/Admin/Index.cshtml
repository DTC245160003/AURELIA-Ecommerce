
@{
    Layout = null;
    ViewData["Title"] = "AURELIA Administration";

    var displayName = User.Identity?.Name ?? "Nhân sự AURELIA";
    var isAdmin = User.IsInRole("Admin");
    var roleName = isAdmin ? "Quản trị viên" : "Nhân viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AURELIA | Administration</title>

    <style>
        :root {
            --bg: #090a0b;
            --panel: #141518;
            --panel2: #191b1e;
            --gold: #d2b47a;
            --gold-light: #efddba;
            --text: #f3f0e9;
            --muted: #999a9c;
            --line: rgba(210,180,122,.18);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Inter, "Segoe UI", Arial, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .shell {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 268px;
            padding: 32px 20px;
            background: #101113;
            border-right: 1px solid var(--line);
            flex-shrink: 0;
        }

        .brand {
            color: var(--gold-light);
            letter-spacing: 5px;
            font-family: "Times New Roman", serif;
            font-size: 27px;
            text-align: center;
        }

        .brand-sub {
            text-align: center;
            color: var(--muted);
            font-size: 10px;
            letter-spacing: 3px;
            margin-top: 9px;
            margin-bottom: 45px;
        }

        .nav-title {
            color: #777;
            font-size: 10px;
            letter-spacing: 2px;
            padding: 0 15px;
            margin-bottom: 12px;
        }

        .nav-link {
            display: block;
            padding: 15px;
            margin-bottom: 8px;
            border-radius: 9px;
            color: #aaa;
            font-size: 13px;
            transition: .2s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: rgba(210,180,122,.10);
            color: var(--gold-light);
        }

        .nav-link.disabled {
            opacity: .55;
            cursor: default;
        }

        .sidebar-note {
            color: #777;
            font-size: 11px;
            line-height: 1.7;
            margin: 36px 14px 0;
            border-top: 1px solid var(--line);
            padding-top: 18px;
        }

        .main {
            flex: 1;
            min-width: 0;
            padding: 32px 42px 60px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding-bottom: 28px;
            border-bottom: 1px solid var(--line);
        }

        .eyebrow {
            font-size: 10px;
            color: var(--gold);
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .topbar h1 {
            font-family: "Times New Roman", serif;
            font-size: 28px;
            font-weight: normal;
            margin: 10px 0 0;
        }

        .account {
            text-align: right;
        }

        .account strong {
            display: block;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .account span {
            font-size: 12px;
            color: var(--gold);
        }

        .welcome {
            padding: 39px 0 27px;
        }

        .welcome h2 {
            font-family: "Times New Roman", serif;
            font-size: clamp(27px, 4vw, 42px);
            font-weight: normal;
            margin: 12px 0;
        }

        .welcome p {
            color: var(--muted);
            line-height: 1.8;
            max-width: 680px;
            font-size: 14px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
            margin-top: 28px;
        }

        .card {
            background: linear-gradient(145deg, #1b1c1e, #111214);
            border: 1px solid var(--line);
            padding: 27px;
            border-radius: 13px;
            min-height: 205px;
        }

        .card-icon {
            font-size: 26px;
            color: var(--gold);
            margin-bottom: 22px;
        }

        .card h3 {
            margin: 0 0 12px;
            font-size: 18px;
            font-weight: 500;
        }

        .card p {
            font-size: 13px;
            line-height: 1.8;
            color: var(--muted);
            margin: 0;
        }

        .card-status {
            display: inline-block;
            margin-top: 19px;
            color: var(--gold);
            font-size: 11px;
            letter-spacing: 1px;
        }

        .card-action {
            display: inline-block;
            margin-top: 18px;
            padding: 10px 15px;
            border: 1px solid var(--line);
            border-radius: 7px;
            color: var(--gold-light);
            font-size: 12px;
            transition: .2s;
        }

        .card-action:hover,
        .card-action:focus-visible {
            background: var(--gold);
            color: #111;
            border-color: var(--gold);
        }

        .notice {
            border: 1px solid var(--line);
            background: rgba(210,180,122,.05);
            margin-top: 25px;
            padding: 20px;
            border-radius: 10px;
            line-height: 1.8;
            font-size: 13px;
            color: #bbb;
        }

        .notice strong {
            color: var(--gold-light);
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
            margin-top: 28px;
        }

        .btn {
            border: 1px solid var(--gold);
            background: transparent;
            color: var(--gold-light);
            padding: 13px 23px;
            border-radius: 7px;
            font-size: 12px;
            cursor: pointer;
            transition: .2s;
        }

        .btn:hover {
            background: var(--gold);
            color: #111;
        }

        .btn-primary {
            background: var(--gold);
            color: #111;
        }

        .btn-primary:hover {
            background: var(--gold-light);
        }

        @@media (max-width: 950px) {
            .sidebar {
                width: 210px;
            }

            .main {
                padding: 25px;
            }
        }

        @@media (max-width: 700px) {
            .shell {
                display: block;
            }

            .sidebar {
                width: 100%;
                padding: 22px 18px;
            }

            .brand-sub {
                margin-bottom: 18px;
            }

            .nav-title,
            .sidebar-note {
                display: none;
            }

            .nav-link {
                display: inline-block;
                margin: 3px;
                padding: 10px;
            }

            .main {
                padding: 22px 17px 40px;
            }

            .topbar {
                align-items: flex-start;
            }

            .topbar h1 {
                font-size: 22px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>

<style id="aurelia-light-style" media="not all">
/* AURELIA light administration: color-only override */
:root{
 --bg:#f8f7f3;--nav:#fff;--panel:#fff;--panel2:#fbfaf7;
 --line:#e5dfd5;--gold:#876438;--gold2:#79572e;--gold-light:#79572e;
 --fg:#282520;--text:#282520;--muted:#706a62;
 --danger:#a33e3e;--ok:#247443
}
html{color-scheme:light}
body{background:#f8f7f3;color:#282520}
.sidebar{background:#ffffff;border-color:#e5dfd5;box-shadow:4px 0 25px rgba(71,52,24,.035)}
.brand,.logo{color:#806039}
.brand-sub,.sublogo,.nav-title,.navtitle,.side-label,.side-footer,.sidebar-note{color:#746f67}
.nav-link,.nav a,.side-nav a{color:#514a40}
.nav-link.active,.nav-link:hover,.nav a.active,.nav a:hover,.side-nav a.active,.side-nav a:hover{background:#f4ead9;color:#725329}
.nav-link.disabled{color:#8c857b}
.card,.metric,.stat,.panel,.info,form.editor{background:#fff;border-color:#e6dfd3;box-shadow:0 10px 26px rgba(75,53,24,.045)}
.table-wrap,.table-scroll{background:#fff;border-color:#e5dfd5}
table{background:#fff}
th{background:#f6f2ea;color:#75552b}
th,td{border-color:#e9e3db}
tbody tr:hover{background:#fbf7f0}
.brand,.metric .num,.stat .value,.card-status,.action,.amount,.code,.eyebrow{color:#856236}
.nav a,.nav-link,.side-nav a{transition:background .2s,color .2s}
.input,select,.field input,.field select,input:not([type=checkbox]):not([type=radio]):not([type=hidden]),textarea{
 background:#fff;color:#25221d;border-color:#d7cbbb
}
input::placeholder,textarea::placeholder{color:#827b70}
.btn,.pill-link,.action,.toolbar-links a{color:#75552d;border-color:#cbb58f;background:#fff}
.btn:hover,.pill-link:hover,.toolbar-links a:hover{background:#f2e8d7;color:#533c20}
.btn-primary,.btn.primary,button.primary,.btn-primary:hover,.btn.primary:hover{
 background:#88663a;color:#fff;border-color:#88663a
}
.btn.light{color:#5c554b;border-color:#bbb3a7}
.btn.danger,.btn-danger{color:#a33e3e;border-color:#dba4a4}
.btn.danger:hover,.btn-danger:hover{background:#a33e3e;color:#fff}
.btn[disabled]{opacity:.45}
.badge.yes,.badge.staff,.badge.user,.badge.no,.status,.status.pending,.status.confirmed,.status.completed,.status.cancelled{
 border-color:transparent
}
.badge.yes{background:#e3f5e9;color:#256d40}
.badge.no{background:#fce8e7;color:#9d3b3b}
.badge.staff{background:#f5ead5;color:#74501c}
.badge.user{background:#e5f0fa;color:#315e85}
.status{background:#fff2dc;color:#835a22;border-color:#e1c69b}
.status.confirmed{background:#e6f1fa;color:#2b5c85;border-color:#b9d6ec}
.status.completed{background:#e5f6e9;color:#23713f;border-color:#b8e2c4}
.status.cancelled{background:#fce8e7;color:#a13f40;border-color:#edc4c4}
.notice,.alert{background:#ebf7ed;color:#286b3d;border-color:#bfe2c7}
.notice.error,.alert.error,.errors{background:#fceceb;color:#a13b3b;border-color:#eac2bf}
.info,.footer{color:#666052}
.field dt,.detail dt{color:#71695d}
.photo{background:#f3eee6}
.pill{color:#267345;border-color:#9cccac}
.pill.off{color:#a23e3e;border-color:#d9aaaa}
@@media(max-width:760px){.sidebar{box-shadow:none}}

/* Sidebar and summary tiles in the root Admin dashboard */
.sidebar{background:#fff}
.nav-link{color:#554c40}.nav-link:hover,.nav-link.active{color:#74532b;background:#f3e8d5}
.card{background:#fff}
.card-status{color:#816035}
.notice{background:#f8f1e6;color:#63594b;border-color:#e5d7c2}
.notice strong{color:#674c28}
.btn{background:#fff;color:#755329}.btn-primary{background:#886438;color:#fff}
.btn:hover{background:#f2e5d0;color:#634823}
.btn-primary:hover{background:#76542b;color:#fff}


</style>
<style id="aurelia-theme-toggle-style">

/* AURELIA THEME SWITCH CONTROL - fixed, does not affect car/banners photos */
#aurelia-theme-toggle {
  all: unset !important;
  position: fixed !important;
  z-index: 2147483000 !important;
  left: 20px !important;
  bottom: 20px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  box-sizing: border-box !important;
  min-height: 44px !important;
  padding: 11px 17px !important;
  border: 1px solid #bda06e !important;
  border-radius: 999px !important;
  background: #18191b !important;
  color: #f3e1c1 !important;
  font: 600 12px/1.2 'Segoe UI', Arial, sans-serif !important;
  letter-spacing: 0 !important;
  white-space: nowrap !important;
  text-decoration: none !important;
  -webkit-text-fill-color: currentColor !important;
  cursor: pointer !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
  transition: background-color .2s,color .2s,transform .15s !important;
}
#aurelia-theme-toggle:hover { transform: translateY(-2px) !important; }
#aurelia-theme-toggle:focus-visible { outline: 3px solid #c8a56a !important; outline-offset: 3px !important; }
#aurelia-theme-toggle .aurelia-theme-icon { font-size: 20px !important; line-height: 1 !important; color: inherit !important; }
#aurelia-theme-toggle .aurelia-theme-label { color: inherit !important; font: inherit !important; }
html[data-aurelia-theme="light"] #aurelia-theme-toggle {
  background: #ffffff !important;
  color: #72552c !important;
  border-color: #cbb17f !important;
  box-shadow: 0 8px 22px rgba(72,51,18,.12) !important;
}
@@media(max-width: 520px) {
  #aurelia-theme-toggle { left: 12px !important; bottom: 12px !important; padding: 9px 13px !important; min-height: 42px !important; }
}

</style>

<script id="aurelia-theme-boot">
// Apply the saved choice before the page is painted (default: original dark theme).
(function () {
  var mode = 'dark';
  try {
    if (window.localStorage.getItem('aurelia.theme') === 'light') mode = 'light';
  } catch (_) { /* Browsers blocking storage still support temporary switching. */ }
  document.documentElement.setAttribute('data-aurelia-theme', mode);
  var lightStyle = document.getElementById('aurelia-light-style');
  if (lightStyle) lightStyle.media = mode === 'light' ? 'all' : 'not all';
})();
</script>

</head>

<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="brand">AURELIA</div>
            <div class="brand-sub">ADMINISTRATION</div>

            <div class="nav-title">QUẢN TRỊ HỆ THỐNG</div>

            <nav aria-label="Quản trị">
                <a class="nav-link active" href="/Admin">
                    ◈ Tổng quan
                </a>

                <a class="nav-link" href="/Admin/Products">
                    ◇ Quản lý siêu xe
                </a>

                <a class="nav-link" href="/Admin/Orders">
                    ◇ Quản lý đơn hàng
                </a>

                <a class="nav-link" href="/Admin/Customers">
                    ◇ Quản lý khách hàng
                </a>

                @if (isAdmin)
                {
                    <a class="nav-link" href="/Admin/Staff">
                        ◇ Phân quyền nhân viên
                    </a>
                }

                <a class="nav-link" href="/">
                    ↗ Xem website
                </a>
            </nav>

            <div class="sidebar-note">
                Quản lý siêu xe, đơn hàng và khách hàng đã kết nối MySQL.
                Chỉ Admin có quyền phân quyền nhân viên.
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div>
                    <div class="eyebrow">AURELIA / MANAGEMENT</div>
                    <h1>Bảng điều khiển</h1>
                </div>

                <div class="account">
                    <strong>@displayName</strong>
                    <span>@roleName</span>
                </div>
            </header>

            <section class="welcome">
                <div class="eyebrow">WELCOME BACK</div>

                <h2>Chào mừng, @displayName</h2>

                <p>
                    Chào mừng đến với hệ thống quản trị
                    AURELIA. Khu vực này dành riêng cho
                    quản trị viên và nhân viên được cấp quyền.
                </p>
            </section>

            <section class="cards" aria-label="Phân hệ quản trị">
                <article class="card">
                    <div class="card-icon">◇</div>
                    <h3>Quản lý siêu xe</h3>
                    <p>
                        Thêm xe, điều chỉnh giá bán, hình ảnh,
                        tồn kho và trạng thái kinh doanh
                        trực tiếp trên MySQL.
                    </p>
                    <div class="card-status">ĐANG HOẠT ĐỘNG</div>
                    <div><a class="card-action" href="/Admin/Products">Mở quản lý siêu xe →</a></div>
                </article>

                <article class="card">
                    <div class="card-icon">▣</div>
                    <h3>Quản lý đơn hàng</h3>
                    <p>
                        Theo dõi đơn đặt xe, xác nhận giao dịch
                        và cập nhật tiến trình xử lý.
                    </p>
                    <div class="card-status">ĐÃ CÓ TRANG QUẢN LÝ</div>
                    <div><a class="card-action" href="/Admin/Orders">Mở quản lý đơn hàng →</a></div>
                </article>

                <article class="card">
                    <div class="card-icon">♙</div>
                    <h3>Quản lý khách hàng</h3>
                    <p>
                        Quản lý thông tin và trạng thái
                        tài khoản khách hàng theo quyền.
                    </p>
                    <div class="card-status">ĐANG HOẠT ĐỘNG</div>
                    <div><a class="card-action" href="/Admin/Customers">Mở quản lý khách hàng →</a></div>
                </article>

                @if (isAdmin)
                {
                    <article class="card">
                        <div class="card-icon">✧</div>
                        <h3>Phân quyền nhân viên</h3>
                        <p>
                            Chỉ Admin có quyền cấp hoặc
                            thu hồi vai trò Staff.
                        </p>
                        <div class="card-status">ĐANG HOẠT ĐỘNG · CHỈ ADMIN</div>
                        <div><a class="card-action" href="/Admin/Staff">Mở phân quyền nhân viên →</a></div>
                    </article>
                }
            </section>

            <div class="notice">
                <strong>Thông tin hệ thống:</strong>
                Đăng nhập và phân quyền truy cập Dashboard sử dụng
                ASP.NET Core. Quản lý siêu xe, đơn hàng và khách hàng đã kết nối
                MySQL. Phân quyền nhân viên đã được kết nối MySQL.
            </div>

            <div class="actions">
                <a class="btn btn-primary" href="/">
                    Về trang chủ AURELIA
                </a>

                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button class="btn" type="submit">
                        Đăng xuất
                    </button>
                </form>
            </div>
        </main>
    </div>

<!-- AURELIA theme switch: site-wide choice saved across pages -->
<button id="aurelia-theme-toggle" type="button" title="Đổi giao diện sáng / tối" aria-label="Chuyển sang nền sáng" aria-pressed="false">
  <span class="aurelia-theme-icon" aria-hidden="true">☀</span>
  <span class="aurelia-theme-label">Nền sáng</span>
</button>
<script id="aurelia-theme-toggle-script">
(function () {
  var button = document.getElementById('aurelia-theme-toggle');
  var lightStyle = document.getElementById('aurelia-light-style');
  if (!button || !lightStyle) return;
  var icon = button.querySelector('.aurelia-theme-icon');
  var label = button.querySelector('.aurelia-theme-label');
  function apply(theme) {
    var light = theme === 'light';
    document.documentElement.setAttribute('data-aurelia-theme', light ? 'light' : 'dark');
    lightStyle.media = light ? 'all' : 'not all';
    icon.textContent = light ? '☾' : '☀';
    label.textContent = light ? 'Nền tối' : 'Nền sáng';
    button.setAttribute('aria-pressed', String(light));
    button.setAttribute('aria-label', light ? 'Chuyển sang nền tối' : 'Chuyển sang nền sáng');
    button.title = light ? 'Chuyển sang nền tối (AURELIA)' : 'Chuyển sang nền sáng (AURELIA)';
  }
  apply(document.documentElement.getAttribute('data-aurelia-theme'));
  button.addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-aurelia-theme') === 'light' ? 'dark' : 'light';
    try { window.localStorage.setItem('aurelia.theme', next); } catch (_) {}
    apply(next);
  });
  window.addEventListener('storage', function (event) {
    if (event.key === 'aurelia.theme') apply(event.newValue === 'light' ? 'light' : 'dark');
  });
})();
</script>

</body>
</html>

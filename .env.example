# AURELIA - Docker Compose Environment

# Mat khau quan tri MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Mat khau MySQL cua ung dung
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# Mat khau quan tri Grafana
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Mat khau tai khoan giam sat MySQL Exporter
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD
